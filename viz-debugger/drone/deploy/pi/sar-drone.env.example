# /etc/sar-drone.env — 드론 파트 서비스(sar-*)와 드론 에이전트 SAR 연동이 같이 읽는다.
# install.sh 가 처음 한 번 이 파일을 복사한다. 현장값만 고친다. 고친 뒤: sudo systemctl restart 'sar-*' drone-node

# 파이썬 venv — drone-node(HW)가 쓰는 것과 같아야 에이전트 연동이 된다
SAR_VENV=/home/physical/venv

# 장비 · 구역 (토픽 zoneA/drone/<id>/…)
SAR_DEVICE=x500-001
SAR_ZONE=zoneA

# MQTT 브로커 host:port — 화면이 붙는 브로커 (보통 노트북 또는 엣지)
SAR_MQTT=192.168.50.244:1883

# mavlink-router 끝점
SAR_FC_TCP=tcp:127.0.0.1:5760
SAR_FC_URL=udpin://0.0.0.0:14540
SAR_ULOG_URL=tcp://127.0.0.1:5760

# 비행 기록 · 레이더 · 캡처 신호
SAR_LOG_DIR=/home/physical/sar_logs
# 레이더(CANSAR-2) 원시 — 패스 끝나고 수 초 안에 iq_N.bin · meta_N.txt 로 복사된다(레이더 팀 README)
SAR_RADAR_DIR=/home/physical/flight
SAR_RADAR_GLOB=iq_*.bin
SAR_CAP_PATH=/home/physical/CAP_ON
# 레이더(cansar)가 CAP_ACK 를 쓰면 경로를 넣는다. 비우면 끔
SAR_CAP_ACK=
# CAP_ACK 가 없을 때 레이더 지연을 재는 대신 — 레이더 기록 프로그램의 events.csv(start · stop) 폴더. 비우면 끔
SAR_CAP_EVENTS=/home/physical/cansar_logs

# RTK 보정 — 노트북 base_sender 가 보내는 UDP 포트
SAR_RTCM_PORT=14660

# 데이터 서버 (화면 「비행 데이터」 · 노트북 미러가 붙는다)
SAR_DATA_PORT=8766
# 레이더 SDR(AD9361) — 기가비트 이더넷. 주소를 넣으면 점검 · 상태판이 유선 속도 · 응답을 본다
SAR_SDR_HOST=
SAR_SDR_PORT=30431
SAR_SDR_IFACE=
# 원시를 패스마다 거리 압축으로 줄여 둘 때(노트북은 줄인 것만 가져간다) — 비우면 끔. radar.json 도 필요
# CANSAR-2: sar_image.cansar:load · radar.json 은 sar_image/example_radar_cansar.json 을 복사해 실측값으로
SAR_REDUCE_ADAPTER=sar_image.cansar:load
SAR_RADAR_JSON=/home/physical/radar.json

# 레이더 팀 quick-look — 그쪽 cansar_quick.py 경로를 넣으면 패스마다 nice 19 로 돌려 화면에 띄운다(캡처 중엔 미룸). 비우면 끔
# 레이더 팀이 정한 자리(10/4): 이 폴더에 cansar_quick.py · cansar_flight.py 를 두고, 고칠 때도 이 폴더만 바꾼다
SAR_CANSAR_QUICK=/home/physical/cansar_radar/cansar_quick.py
SAR_CANSAR_DATA=/home/physical/flight
SAR_CANSAR_LOGS=/home/physical/cansar_logs
# 안테나가 보는 쪽(진행 방향 기준) — 비행 전에 레이더 팀이 알려 준다: right | left
SAR_CANSAR_SIDE=right
# 레이더 팀 quick 의 --lever(안테나 위치 F R D m)는 SAR_RADAR_JSON 의 antenna_offset_m 을 그대로 쓴다 — 실측하면 radar.json 만 고친다
