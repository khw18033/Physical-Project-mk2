{
  "name": "hybrid-dt-viz-debugger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "임무 실행 기록 디버거 — 0단계 골격",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:mock": "node gateway/server.ts",
    "dev:web": "vite",
    "dev:stt": "node scripts/dev-stt.mjs",
    "build": "tsc -b && vite build",
    "build:standalone": "tsc -b && vite build --config vite.standalone.config.ts",
    "typecheck": "tsc -b --force && tsc -p gateway/tsconfig.json",
    "verify:hierarchy": "node scripts/verify-hierarchy.mjs",
    "verify:adapter-swap": "node scripts/verify-adapter-swap.mjs",
    "verify:transport": "node scripts/verify-transport.mjs",
    "verify:scenario": "node scripts/verify-scenario.mjs",
    "verify:trace-append": "node scripts/verify-trace-append.mjs",
    "verify:replay": "node scripts/verify-replay.mjs",
    "verify:human-trace": "node scripts/verify-human-trace.mjs",
    "verify:dep-rules": "node scripts/verify-dep-rules.mjs",
    "verify:no-llm": "node scripts/verify-no-llm.mjs",
    "verify:gen-port": "node scripts/verify-gen-port.mjs",
    "verify:layout": "node scripts/verify-layout.mjs",
    "verify:single-egress": "node scripts/verify-single-egress.mjs",
    "verify:standalone": "npm run build:standalone && node scripts/verify-standalone.mjs",
    "verify:stt-port": "node scripts/verify-stt-port.mjs",
    "verify:voice-audit": "node scripts/verify-voice-audit.mjs",
    "verify:no-stt": "node scripts/verify-no-stt.mjs",
    "verify:one-gateway": "node scripts/verify-one-gateway.mjs",
    "verify:placeholder-default": "node scripts/verify-placeholder-default.mjs",
    "verify:script-library": "node scripts/verify-script-library.mjs",
    "verify:scenario-mode": "node scripts/verify-scenario-mode.mjs",
    "verify:node-scope": "node scripts/verify-node-scope.mjs",
    "verify:canvas-persist": "node scripts/verify-canvas-persist.mjs",
    "verify:view-nodes": "node scripts/verify-view-nodes.mjs",
    "verify:no-tabs": "node scripts/verify-no-tabs.mjs",
    "measure:representation": "node scripts/measure-representation.mjs",
    "goldset:extract": "node scripts/extract-goldset.mjs",
    "score:generation": "node scripts/score-generation.mjs",
    "extract:places": "node scripts/extract-places.mjs",
    "verify:places": "node scripts/verify-places.mjs",
    "verify:no-leak": "node scripts/verify-no-leak.mjs",
    "baseline:run": "node scripts/run-baseline.mjs",
    "baseline:report": "node scripts/report-baseline.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
