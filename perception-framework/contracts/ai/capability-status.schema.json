{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physical-project.local/contracts/ai/capability-status.schema.json",
  "title": "AI Capability Status",
  "type": "object",
  "required": ["capability_kind", "provider_id", "state", "reason", "changed_at"],
  "properties": {
    "capability_kind": {"type": "string", "minLength": 1},
    "provider_id": {"type": ["string", "null"]},
    "state": {"enum": ["ACTIVE", "DEGRADED", "DISABLED"]},
    "reason": {"type": ["string", "null"]},
    "cluster_id": {"type": ["string", "null"]},
    "changed_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
