# 임무 이력 서버 (가시화 요청 261119) — 노트북 WSL(Ubuntu-26.04) 판 · http://100.125.104.23:8850/api/v1
# 원격 서버판(2026-11-19)에서 사용자 · 경로 · 주소 · 환경 파일 · 순서만 바꿨다(261125). 프로그램은 원격 서버와 같은 v2 다.
#
# 설치(WSL 에서 사람이):  sudo install -m 644 mission-history.service /etc/systemd/system/
#                        sudo systemctl daemon-reload && sudo systemctl enable --now mission-history
#                        enable = WSL 이 켜질 때마다 같이 뜬다(원격 서버에서 「서버가 켜질 때마다」 와 같다)
# 코드를 고친 뒤:        /home/khw67/mission_history/server/ 의 파일을 바꾸고 sudo systemctl restart mission-history
# 로그:                  journalctl -u mission-history -f
#
# WSL tailnet 주소(100.125.104.23)에 바인딩하므로 tailscaled 뒤에 뜬다. 먼저 뜨면 주소가 없어 죽고 10초 뒤 다시 뜬다.
# DB 비밀번호(MK2_TSDB_PASSWORD)는 /home/khw67/mission_history/mission-history.env 에서 읽는다(권한 600 · 사람이 넣는다).
# network-online.target 은 걸지 않았다 — WSL 에서는 망을 WSL 이 직접 잡아 그 대상을 기다릴 까닭이 없다.

[Unit]
Description=Mission history server (VZ mission records, HTTP :8850)
After=tailscaled.service postgresql.service
Wants=tailscaled.service postgresql.service

[Service]
Type=simple
User=khw67
WorkingDirectory=/home/khw67/mission_history/server
EnvironmentFile=/home/khw67/mission_history/mission-history.env
Environment=PYTHONUNBUFFERED=1
Environment=MH_HOST=100.125.104.23
Environment=MH_PORT=8850
Environment=MH_IMAGES_DIR=/home/khw67/mission_history/images
ExecStart=/home/khw67/mission_history/venv/bin/python /home/khw67/mission_history/server/mission_history_server.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
