{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mission.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "utterance", "milestones"],
  "properties": {
    "mission_id": { "type": "string", "minLength": 1 },
    "utterance": {
      "type": "object", "additionalProperties": false,
      "required": ["audio_ref", "text", "engine", "confidence"],
      "properties": {
        "audio_ref": { "type": ["string", "null"] }, "text": { "type": "string" },
        "engine": { "type": "string" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "milestones": { "type": "array", "items": { "$ref": "milestone.schema.json" } }
  }
}
