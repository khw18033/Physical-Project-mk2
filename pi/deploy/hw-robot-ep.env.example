# RoboMaster EP 온보드 노드 현장 설정 — /etc/hw-robot-ep.env 로 복사해 값만 채운다.
# 컨테이너로 띄우면 docker-compose.yml 의 environment 가 이미 같은 값을 준다.
# systemd 로 직접 돌릴 때만 이 파일을 쓴다.

HW_CONTROLLER_LINK=ep

# 연결 방식. rndis = USB 케이블(파이 usb0 ↔ 로봇 192.168.42.2). 유선이라 랩 Wi-Fi
# 상태와 무관하다. sta = 공유기 경유, ap = 로봇 핫스팟 직결.
HW_EP_CONN_TYPE=rndis

# 식별자. 센서노드(wl-001)·Go1(go1-001)과 반드시 달라야 한다 — 같은 client_id 로
# 두 노드가 붙으면 서로를 끊는다.
HW_ENTITY_ID=ep-001
HW_ENTITY_TYPE=robot
HW_DEVICE_TYPE=robomaster_ep

# 안전값. 링크가 상위 명령을 이 상한으로 클램프하고, 갱신이 끊기면 워치독이 세운다.
#HW_EP_MAX_SPEED=0.5
#HW_EP_CMD_TIMEOUT_S=1.0
#HW_EP_MISSION_SPEED=0.3
