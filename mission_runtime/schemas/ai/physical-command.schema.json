{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physical-project.local/schemas/ai/physical-command.schema.json",
  "title": "Physical command lifecycle message",
  "type": "object",
  "required": [
    "message_type",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "message_type": {
      "enum": [
        "command",
        "acceptance",
        "status",
        "result",
        "cancel_request",
        "cancel_response",
        "capability"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "command"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/command"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "acceptance"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/acceptance"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "status"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/status"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "result"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "cancel_request"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/cancel_request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "cancel_response"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/cancel_response"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "capability"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/capability"
          }
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "required": [
        "command_id",
        "target",
        "action",
        "parameters"
      ],
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "description": "canonical 와이어는 map<string,double> 이므로 숫자만 전달된다(spec §8-3 P2).",
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "의미 계약에만 있다 — 현재 와이어에는 자리가 없다(spec §8-3 P1)."
        },
        "deadline": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "acceptance": {
      "type": "object",
      "required": [
        "command_id",
        "accepted",
        "accepted_at"
      ],
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "accepted": {
          "type": "boolean"
        },
        "accepted_at": {
          "type": "number"
        },
        "rejection": {
          "anyOf": [
            {
              "$ref": "#/$defs/rejection"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_source": {
          "enum": [
            "device_reported",
            "edge_receipt"
          ]
        }
      }
    },
    "rejection": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "command_id",
        "status",
        "observed_at"
      ],
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ACCEPTED",
            "EXECUTING",
            "CANCELING",
            "SUCCEEDED",
            "ABORTED",
            "CANCELED"
          ]
        },
        "observed_at": {
          "type": "number"
        },
        "time_source": {
          "enum": [
            "device_reported",
            "edge_receipt"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ],
          "description": "장치가 보낸 진행 설명. 의미 모델에는 아직 자리가 없고 payload 로만 전달된다."
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "command_id",
        "status",
        "completed_at"
      ],
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "ABORTED",
            "CANCELED"
          ]
        },
        "completed_at": {
          "type": "number"
        },
        "result": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/failure"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_source": {
          "enum": [
            "device_reported",
            "edge_receipt"
          ]
        }
      }
    },
    "failure": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      }
    },
    "cancel_request": {
      "type": "object",
      "required": [
        "command_id"
      ],
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cancel_response": {
      "type": "object",
      "required": [
        "command_id",
        "accepted"
      ],
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "accepted": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "의미 계약에만 있다 — 현재 와이어에는 자리가 없다(spec §8-3 P6)."
        }
      }
    },
    "capability": {
      "description": "두 모양을 모두 허용한다. declaration 은 AI-C-18 선언 전체이고, announcement 는 현재 HW 와이어가 실제로 싣는 것(device_id + action 이름)이다.",
      "oneOf": [
        {
          "$ref": "#/$defs/capability_declaration"
        },
        {
          "$ref": "#/$defs/capability_announcement"
        }
      ]
    },
    "capability_declaration": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "parameter_schema": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "result_schema": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "cancel_supported": {
          "type": "boolean"
        },
        "required_resources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "capability_announcement": {
      "type": "object",
      "required": [
        "device_id",
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "declaration_scope": {
          "const": "actions_only"
        }
      }
    }
  },
  "description": "우리 의미 계약(contracts/physical_command.py)의 디버깅용 JSON 표현. 실제 통신 정본은 physical_command.proto(package physical, HW 규약 — spec §8)이며 여기에 있는 필드 중 일부는 그 와이어에 자리가 없다(spec §8-3). time_source 는 시각이 장치 보고가 아니라 엣지 수신 시각임을 뜻한다."
}
