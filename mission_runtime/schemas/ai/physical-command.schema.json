{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physical-project.local/schemas/ai/physical-command.schema.json",
  "title": "Physical command lifecycle message",
  "type": "object",
  "required": [
    "message_type",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "message_type": {
      "enum": [
        "command",
        "acceptance",
        "status",
        "result",
        "cancel_request",
        "cancel_response",
        "capability"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "command"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/command"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "acceptance"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/acceptance"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "status"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/status"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "result"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "cancel_request"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/cancel_request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "cancel_response"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/cancel_response"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "capability"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/capability"
          }
        }
      }
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "required": [
        "command_id",
        "target",
        "action",
        "parameters"
      ],
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "description": "canonical 와이어는 map<string,double> 이므로 숫자만 전달된다(spec §8-3 P2).",
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "의미 계약에만 있다 — 현재 와이어에는 자리가 없다(spec §8-3 P1)."
        },
        "deadline": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "acceptance": {
      "type": "object",
      "required": [
        "command_id",
        "accepted",
        "accepted_at"
      ],
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "accepted": {
          "type": "boolean"
        },
        "accepted_at": {
          "type": "number"
        },
        "rejection": {
          "anyOf": [
            {
              "$ref": "#/$defs/rejection"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_source": {
          "enum": [
            "device_reported",
            "edge_receipt"
          ]
        }
      }
    },
    "rejection": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "command_id",
        "status",
        "observed_at"
      ],
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ACCEPTED",
            "EXECUTING",
            "CANCELING",
            "SUCCEEDED",
            "ABORTED",
            "CANCELED"
          ]
        },
        "observed_at": {
          "type": "number"
        },
        "time_source": {
          "enum": [
            "device_reported",
            "edge_receipt"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ],
          "description": "장치가 보낸 진행 설명. 의미 모델에는 아직 자리가 없고 payload 로만 전달된다."
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "command_id",
        "status",
        "completed_at"
      ],
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "ABORTED",
            "CANCELED"
          ]
        },
        "completed_at": {
          "type": "number"
        },
        "result": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/failure"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_source": {
          "enum": [
            "device_reported",
            "edge_receipt"
          ]
        }
      }
    },
    "failure": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      }
    },
    "cancel_request": {
      "type": "object",
      "required": [
        "command_id"
      ],
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cancel_response": {
      "type": "object",
      "required": [
        "command_id",
        "accepted"
      ],
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "accepted": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "의미 계약에만 있다 — 현재 와이어에는 자리가 없다(spec §8-3 P6)."
        }
      }
    },
    "capability": {
      "description": "두 모양을 모두 허용한다. declaration 은 AI-C-18 선언 전체이고, announcement 는 현재 HW 와이어가 실제로 싣는 것(device_id + action 이름)이다.",
      "oneOf": [
        {
          "$ref": "#/$defs/capability_declaration"
        },
        {
          "$ref": "#/$defs/capability_announcement"
        }
      ]
    },
    "capability_declaration": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "parameter_schema": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "result_schema": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "cancel_supported": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "true/false/null(미선언). null 을 false 로 접지 않는다."
        },
        "required_resources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "idempotent": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "동일 입력 반복 호출 특성. null 은 미선언이고 '멱등하지 않다' 가 아니다."
        },
        "invocation": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "synchronous",
            "asynchronous",
            null
          ],
          "description": "동기·비동기 특성. null 은 미선언."
        },
        "optional_resources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "선택 실행 조건. 결손은 DEGRADED 까지만(AI-C-05)."
        },
        "basis": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "description": "단위·좌표·시간 기준(AI-C-18). null 은 기준을 선언하지 않은 것이고 '기준이 없다' 가 아니다.",
          "properties": {
            "units": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "매개변수·결과 이름 -> 단위 기호. 적지 않은 이름은 단위를 모르는 것이다."
            },
            "reference_frame": {
              "type": [
                "string",
                "null"
              ],
              "description": "공간 값의 기준 좌표계(AI-C-02). 로컬과 전역을 같은 칸에 담지 않는다."
            },
            "time_basis": {
              "type": [
                "string",
                "null"
              ],
              "description": "시각 값의 기준(AI-C-03)."
            }
          }
        },
        "scope_tags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "수행·관측 범위. null(미선언)과 [](제약 없음 선언)은 다른 값이다."
        },
        "execution_profile_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "품질·지연·자원 실측 근거(AI-B-01 ExecutionProfile) 참조. 숫자를 베껴 두지 않는다."
        }
      }
    },
    "capability_announcement": {
      "type": "object",
      "required": [
        "device_id",
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "declaration_scope": {
          "const": "actions_only"
        },
        "undeclared_items": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "meaning",
              "input_schema",
              "output_schema",
              "basis",
              "execution_conditions",
              "cancellable",
              "idempotent",
              "invocation",
              "scope",
              "state",
              "version",
              "performance"
            ]
          },
          "description": "이 공지가 적지 못한 AI-C-18 항목들. 빈 칸을 기본값으로 채워 보내지 않는 대신 **이름으로** 남긴다 — 받는 쪽이 '장치가 그렇다고 선언했다' 와 '와이어에 자리가 없어 못 왔다' 를 구분할 수 있어야 한다(spec §8-3 P7)."
        }
      }
    }
  },
  "description": "우리 의미 계약(contracts/physical_command.py)의 디버깅용 JSON 표현. 실제 통신 정본은 physical_command.proto(package physical, HW 규약 — spec §8)이며 여기에 있는 필드 중 일부는 그 와이어에 자리가 없다(spec §8-3). time_source 는 시각이 장치 보고가 아니라 엣지 수신 시각임을 뜻한다."
}
