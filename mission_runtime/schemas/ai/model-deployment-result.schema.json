{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physical-project.local/schemas/ai/model-deployment-result.schema.json",
  "title": "Model Deployment Result",
  "type": "object",
  "required": [
    "deployment_id",
    "model_id",
    "model_version",
    "artifact_ref",
    "checksum",
    "target_node_id",
    "status",
    "previous_version",
    "reason",
    "occurred_at"
  ],
  "properties": {
    "deployment_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1
    },
    "checksum": {
      "type": "string",
      "minLength": 1
    },
    "target_node_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "REQUESTED",
        "DOWNLOADING",
        "VALIDATING",
        "APPLIED",
        "FAILED",
        "ROLLED_BACK"
      ]
    },
    "previous_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true,
  "$comment": "2026-10-27: 본문이 봉투와 같은 층에 실리므로 추가 칸을 막지 않는다(규약 R12 — 모르는 칸은 통과시킨다)."
}
