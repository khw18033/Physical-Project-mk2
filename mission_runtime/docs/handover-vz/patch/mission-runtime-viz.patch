+// ── 장치 관리(배포) ──────────────────────────────────────────────────────────
+
+type Deployment = {
+  permissions?: Record<string, string>;
+  join?: { joined?: readonly unknown[]; steps?: readonly string[]; pending?: Record<string, unknown>; refused?: readonly unknown[]; may_submit?: boolean; known_device_ids?: readonly string[] } | null;
+  calibration?: { cameras?: readonly { device_id: string; state?: string | null; views?: number | null; reason?: string | null }[]; frames_root_present?: boolean; min_views?: number; may_submit?: boolean } | null;
+  training?: {
+    /** 조건 묶음별 후보 수. **확인된 수와 전체 수를 갈라서** 온다(AI-L-02). */
+    groups?: readonly {
+      group_key: string; device_id?: string | null; camera_id?: string | null;
+      accelerator_id?: string | null; total?: number | null; confirmed?: number | null;
+      labels?: readonly string[] | null; base_version?: string | null;
+      trainable?: boolean | null; min_samples?: number | null;
+    }[];
+    candidates?: readonly unknown[];
+    /** **거짓이면 「없다」가 아니라 「볼 수 없다」다** — 서버가 권한 없는 호출에
+        빈 목록을 돌려주기 때문이다. 둘을 같은 빈칸으로 그리면 운영자가 다음에 무엇을
+        해야 하는지 알 수 없다. */
+    may_submit?: boolean;
+  } | null;
+  model?: {
+    versions?: readonly { reference?: string; model_id?: string; version?: string; capability_kind?: string; verified_hw_tags?: readonly string[]; quality?: number | null; latency_ms?: number | null }[];
+    devices?: readonly {
+      device_id: string;
+      hw_tags?: readonly string[];
+      memory_mb?: number | null;
+      /** **기능별 적용 버전의 표다** — 문자열이 아니다. 비어 있으면 적용 없음. */
+      applied?: Record<string, unknown> | null;
+    }[];
+    deployments?: readonly unknown[];
+    capability_kinds?: readonly string[];
+    may_submit?: boolean;
+  } | null;
+};
+
+/** 네 가지가 **실제 순서대로** 선다 — 들이기 · 보정 · 학습 · 모델 교체. */
+const STAGES = [
+  { key: 'fms.deploy.join', perm: 'join' },
+  { key: 'fms.deploy.calibration', perm: 'calibration' },
+  { key: 'fms.deploy.training', perm: 'training' },
+  { key: 'fms.deploy.model', perm: 'model' },
+] as const;
+
+export function FmsDeploymentCard() {
+  useLang();
+  const state = useFms<Deployment>('/api/deployment');
+  return <FmsBody state={state} card>{(body) => {
+    const joined = body.join?.joined?.length ?? 0;
+    const known = body.join?.known_device_ids?.length ?? 0;
+    const cameras = body.calibration?.cameras?.length ?? 0;
+    const candidates = body.training?.candidates?.length ?? 0;
+    const versions = body.model?.versions?.length ?? 0;
+    return <>
+      <div className="fms-card__line">
+        <b>{t('fms.deploy.join')}</b><span className="fms-num">{t('fms.deploy.joinedOf', { joined, known })}</span>
+      </div>
+      <div className="fms-card__line">
+        <b>{t('fms.deploy.calibration')}</b><span className="fms-num">{cameras}</span>
+        {body.calibration?.frames_root_present === false
+          && <span className="fms-state fms-state--unmeasured">{t('fms.deploy.noFrames')}</span>}
+      </div>
+      <div className="fms-card__line">
+        <b>{t('fms.deploy.training')}</b><span className="fms-num">{candidates}</span>
+        <b>{t('fms.deploy.model')}</b><span className="fms-num">{versions}</span>
+      </div>
+      {/* 권한이 없는 자리는 비는 대신 **무슨 능력이 필요한지**를 적는다 — 빈 목록은
+          「할 일이 없다」와 「볼 수 없다」를 구분하지 못한다. */}
+      <ul className="fms-chips">{STAGES.map((stage) => {
+        const permission = body.permissions?.[stage.perm];
+        return <li key={stage.perm}>{t(stage.key)}: {permission ?? '—'}</li>;
+      })}</ul>
+    </>;
+  }}</FmsBody>;
+}
