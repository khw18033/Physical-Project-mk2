@@ -0,0 +1,253 @@
+/**
+ * src/fms/views/FmsMission.tsx (261105 — 추천 임무 · 서브태스크 접지)
+ *
+ * **AI 는 후보와 사유만 낸다.** 임무 발령과 실행은 우리 것이 아니고(AI-C-19) 이 노드도
+ * 발령 단추를 두지 않는다 — 조회만이다. 발령은 제어 계약을 거친다.
+ *
+ * 두 노드가 한 파일에 있는 이유: 추천이 내는 `goal_kind` 가 그대로 서브태스크의
+ * 질의 인자다. 같은 어휘를 두 파일에 적으면 한쪽만 고쳐지는 날이 온다.
+ */
+
+import { useState, type ReactElement } from 'react';
+import { useLang } from '../../shared/language.ts';
+import { t } from '../../i18n/dict.ts';
+import { useFms } from '../useFms.ts';
+import { FmsBody, FmsHead, FmsNone } from './FmsShell.tsx';
+
+type Recommendation = {
+  mission_kind: string;
+  title?: string | null;
+  goal_kind: string;
+  recommended: boolean;
+  reason: string;
+  matched_triggers?: readonly string[];
+  missing_capabilities?: readonly string[];
+  subjects?: readonly unknown[];
+  priority?: number | null;
+};
+
+type Recommendations = { recommendations?: readonly Recommendation[] };
+
+type Binding = { capability_kind: string; provider_id?: string | null; source?: string | null; optional?: boolean };
+
+type SubtaskNode = {
+  subtask_id: string;
+  action: string;
+  order_index?: number;
+  state?: string | null;
+  executable?: boolean;
+  runs_on?: readonly string[];
+  bindings?: readonly Binding[];
+  missing_required?: readonly string[];
+  missing_optional?: readonly string[];
+  unverified_preconditions?: readonly string[];
+  violated_forbidden?: readonly string[];
+  unmet_inputs?: readonly string[];
+  cost?: { compute_units?: number; memory_mb?: number } | null;
+};
+
+type Plan = {
+  plan_id?: string;
+  goal_kind?: string;
+  zone_id?: string | null;
+  robot_id?: string | null;
+  generator?: string | null;
+  template_version?: string | null;
+  reason?: string | null;
+  executor?: { executor_id?: string | null; state?: string | null; reason?: string | null } | null;
+  nodes?: readonly SubtaskNode[];
+  edges?: readonly unknown[];
+  escalation_capabilities?: readonly string[];
+  cost_total?: { compute_units?: number; memory_mb?: number } | null;
+};
+
+/** 로봇을 고르는 줄. 고르지 않았으면 **읽지 않는다** — 없는 질의를 던지지 않는다. */
+function useRobotChoice(): { robot: string | null; picker: ReactElement } {
+  useLang();
+  const scene = useFms<{ domains?: readonly { domain_id: string }[] }>('/api/scene');
+  const domainId = scene.body?.domains?.[0]?.domain_id ?? null;
+  const domain = useFms<{ zones?: readonly { zone_id: string; robots?: readonly { node_id: string; label?: string | null }[] }[] }>(
+    domainId === null ? null : `/api/domain?id=${encodeURIComponent(domainId)}`);
+  const robots = (domain.body?.zones ?? []).flatMap((z) => (z.robots ?? []).map((r) => ({ ...r, zone: z.zone_id })));
+  const [picked, setPicked] = useState<string | null>(null);
+  const robot = picked ?? robots[0]?.node_id ?? null;
+  const picker = <select value={robot ?? ''} onChange={(e) => setPicked(e.target.value)}>
+    {robots.length === 0 && <option value="">{t('fms.noRobot')}</option>}
+    {robots.map((r) => <option key={r.node_id} value={r.node_id}>{r.label ?? r.node_id}</option>)}
+  </select>;
+  return { robot, picker };
+}
+
+export function FmsRecommendCard() {
+  useLang();
+  const { robot } = useRobotChoice();
+  const state = useFms<Recommendations>(robot === null ? null : `/api/recommend?robot=${encodeURIComponent(robot)}`);
+  return <FmsBody state={state} card>{(body) => {
+    const all = body.recommendations ?? [];
+    const on = all.filter((r) => r.recommended);
+    const blocked = all.filter((r) => !r.recommended);
+    return <>
+      <div className="fms-card__line">
+        <b>{t('fms.recommend.on')}</b><span className="fms-num">{on.length}</span>
+        {/* 막힌 후보를 감추지 않는다 — 다음에 무엇을 보완해야 하는지가 거기 있다(AI-B-15). */}
+        <b>{t('fms.recommend.blocked')}</b><span className="fms-num">{blocked.length}</span>
+      </div>
+      {on[0] !== undefined && <div className="fms-card__line">
+        <span>{on[0].title ?? on[0].mission_kind}</span>
+        <span className="fms-state fms-state--ok">{on[0].reason}</span>
+      </div>}
+      {blocked[0] !== undefined && <div className="fms-card__line">
+        <span>{blocked[0].title ?? blocked[0].mission_kind}</span>
+        <span className="fms-state fms-state--bad">{blocked[0].reason}</span>
+      </div>}
+      {all.length === 0 && <FmsNone messageKey="fms.recommend.none" />}
+    </>;
+  }}</FmsBody>;
+}
+
+export function FmsRecommendZoom() {
+  useLang();
+  const { robot, picker } = useRobotChoice();
+  const state = useFms<Recommendations>(robot === null ? null : `/api/recommend?robot=${encodeURIComponent(robot)}`);
+  return <div className="fms-zoom">
+    <FmsHead titleKey="viewnode.fmsRecommend" state={state} extra={<span className="fms-actions">{picker}</span>} />
+    <FmsBody state={state}>{(body) => {
+      const all = [...(body.recommendations ?? [])].sort((a, b) => (b.priority ?? 0) - (a.priority ?? 0));
+      if (all.length === 0) return <FmsNone messageKey="fms.recommend.none" />;
+      return <section>
+        <h4>{t('fms.recommend.title')}</h4>
+        <table className="fms-table">
+          <thead><tr>
+            <th>{t('fms.recommend.mission')}</th><th>{t('fms.recommend.verdict')}</th>
+            <th>{t('fms.recommend.triggers')}</th><th>{t('fms.recommend.missing')}</th>
+          </tr></thead>
+          <tbody>{all.map((r) => <tr key={r.mission_kind} className={r.recommended ? '' : 'is-blocked'}>
+            <td>{r.title ?? r.mission_kind}<br /><span className="fms-hint">{r.goal_kind}</span></td>
+            <td><span className={`fms-state fms-state--${r.recommended ? 'ok' : 'bad'}`}>{r.reason}</span></td>
+            <td><ul className="fms-chips">{(r.matched_triggers ?? []).map((x) => <li key={x}>{x}</li>)}</ul></td>
+            <td><ul className="fms-chips">{(r.missing_capabilities ?? []).map((x) => <li key={x} className="is-missing">{x}</li>)}</ul></td>
+          </tr>)}</tbody>
+        </table>
+        {/* 발령 단추를 두지 않는다 — AI 는 후보와 사유만 낸다(AI-C-19). */}
+        <p className="fms-hint">{t('fms.recommend.notAnOrder')}</p>
+      </section>;
+    }}</FmsBody>
+  </div>;
+}
+
+/** 단계 하나가 막힌 이유를 **종류별로** 모은다. 한 칸에 뭉치면 무엇이 없는지 사라진다. */
+function blockers(node: SubtaskNode): { key: string; items: readonly string[] }[] {
+  return [
+    { key: 'fms.subtasks.missingRequired', items: node.missing_required ?? [] },
+    { key: 'fms.subtasks.unmetInputs', items: node.unmet_inputs ?? [] },
+    { key: 'fms.subtasks.unverified', items: node.unverified_preconditions ?? [] },
+    { key: 'fms.subtasks.forbidden', items: node.violated_forbidden ?? [] },
+  ].filter((group) => group.items.length > 0);
+}
+
+export function FmsSubtasksCard() {
+  useLang();
+  const { robot } = useRobotChoice();
+  const recommend = useFms<Recommendations>(robot === null ? null : `/api/recommend?robot=${encodeURIComponent(robot)}`);
+  const goal = recommend.body?.recommendations?.find((r) => r.recommended)?.goal_kind
+    ?? recommend.body?.recommendations?.[0]?.goal_kind ?? null;
+  const state = useFms<Plan>(robot === null || goal === null
+    ? null
+    : `/api/subtasks?robot=${encodeURIComponent(robot)}&function=${encodeURIComponent(goal)}`);
+  return <FmsBody state={state} card>{(body) => {
+    const nodes = body.nodes ?? [];
+    const runnable = nodes.filter((n) => n.executable === true).length;
+    const cost = body.cost_total;
+    return <>
+      <div className="fms-card__line">
+        <b>{t('fms.subtasks.steps')}</b><span className="fms-num">{nodes.length}</span>
+        <span className={`fms-state fms-state--${runnable === nodes.length && nodes.length > 0 ? 'ok' : 'bad'}`}>
+          {t('fms.subtasks.runnable', { runnable, total: nodes.length })}
+        </span>
+      </div>
+      <div className="fms-card__line">
+        <b>{t('fms.subtasks.verdict')}</b><span>{body.reason ?? '—'}</span>
+      </div>
+      <div className="fms-card__line">
+        <b>{t('fms.subtasks.cost')}</b>
+        {cost === null || cost === undefined
+          ? <span className="fms-state fms-state--unmeasured">{t('fms.unmeasured')}</span>
+          : <span className="fms-num">{t('fms.subtasks.costValue', {
+            cu: (cost.compute_units ?? 0).toFixed(1), mb: (cost.memory_mb ?? 0).toFixed(0),
+          })}</span>}
+      </div>
+      {nodes.length === 0 && <FmsNone messageKey="fms.subtasks.none" />}
+    </>;
+  }}</FmsBody>;
+}
+
+export function FmsSubtasksZoom() {
+  useLang();
+  const { robot, picker } = useRobotChoice();
+  const recommend = useFms<Recommendations>(robot === null ? null : `/api/recommend?robot=${encodeURIComponent(robot)}`);
+  const options = recommend.body?.recommendations ?? [];
+  const [picked, setPicked] = useState<string | null>(null);
+  const goal = picked ?? options.find((r) => r.recommended)?.goal_kind ?? options[0]?.goal_kind ?? null;
+  const state = useFms<Plan>(robot === null || goal === null
+    ? null
+    : `/api/subtasks?robot=${encodeURIComponent(robot)}&function=${encodeURIComponent(goal)}`);
+  return <div className="fms-zoom">
+    <FmsHead titleKey="viewnode.fmsSubtasks" state={state} extra={<span className="fms-actions">
+      {picker}
+      <select value={goal ?? ''} onChange={(e) => setPicked(e.target.value)}>
+        {options.length === 0 && <option value="">{t('fms.subtasks.noGoal')}</option>}
+        {options.map((r) => <option key={r.goal_kind} value={r.goal_kind}>{r.title ?? r.goal_kind}</option>)}
+      </select>
+    </span>} />
+    <FmsBody state={state}>{(body) => {
+      const nodes = [...(body.nodes ?? [])].sort((a, b) => (a.order_index ?? 0) - (b.order_index ?? 0));
+      return <>
+        <section>
+          <h4>{t('fms.subtasks.plan')}</h4>
+          <table className="fms-table"><tbody>
+            <tr><th>{t('fms.subtasks.generator')}</th><td>{body.generator ?? '—'}{body.template_version === null || body.template_version === undefined ? '' : ` · ${body.template_version}`}</td></tr>
+            <tr><th>{t('fms.subtasks.verdict')}</th><td>{body.reason ?? '—'}</td></tr>
+            <tr><th>{t('fms.subtasks.executor')}</th><td>
+              {body.executor?.executor_id ?? '—'}
+              {body.executor?.state !== undefined && body.executor?.state !== null
+                && <span className={`fms-state fms-state--${body.executor.state === 'ACTIVE' ? 'ok' : body.executor.state === 'DEGRADED' ? 'warn' : 'bad'}`}>{body.executor.state}</span>}
+              {body.executor?.reason !== undefined && body.executor?.reason !== null && <span className="fms-hint"> {body.executor.reason}</span>}
+            </td></tr>
+            <tr><th>{t('fms.subtasks.escalation')}</th><td>
+              {/* 어휘 밖 기능을 가리킨 단계는 거부되고 그 이름이 보존된다 — 그것이
+                  수행 불가 기능의 외부 개발 요청으로 이어진다(AI-B-14 · AI-B-13). */}
+              {(body.escalation_capabilities ?? []).length === 0
+                ? <span className="fms-hint">{t('fms.subtasks.noEscalation')}</span>
+                : <ul className="fms-chips">{(body.escalation_capabilities ?? []).map((c) => <li key={c} className="is-missing">{c}</li>)}</ul>}
+            </td></tr>
+          </tbody></table>
+        </section>
+        <section>
+          <h4>{t('fms.subtasks.steps')}</h4>
+          {nodes.length === 0 ? <FmsNone messageKey="fms.subtasks.none" /> : <table className="fms-table">
+            <thead><tr>
+              <th>#</th><th>{t('fms.subtasks.action')}</th><th>{t('fms.subtasks.runsOn')}</th>
+              <th>{t('fms.subtasks.bindings')}</th><th>{t('fms.subtasks.blocked')}</th>
+            </tr></thead>
+            <tbody>{nodes.map((n) => <tr key={n.subtask_id} className={n.executable === true ? '' : 'is-blocked'}>
+              <td className="fms-num">{(n.order_index ?? 0) + 1}</td>
+              <td>{n.action}
+                <span className={`fms-state fms-state--${n.state === 'ACTIVE' ? 'ok' : n.state === 'DEGRADED' ? 'warn' : 'bad'}`}>{n.state ?? '—'}</span>
+              </td>
+              <td><ul className="fms-chips">{(n.runs_on ?? []).map((x) => <li key={x}>{x}</li>)}</ul></td>
+              <td><ul className="fms-chips">{(n.bindings ?? []).map((b) => <li key={b.capability_kind}>
+                {b.capability_kind}{b.provider_id === null || b.provider_id === undefined ? '' : ` → ${b.provider_id}`}
+                {b.optional === true ? ` (${t('fms.subtasks.optional')})` : ''}
+              </li>)}</ul></td>
+              <td>{blockers(n).length === 0 ? <span className="fms-hint">—</span>
+                : blockers(n).map((group) => <div key={group.key}>
+                  <span className="fms-hint">{t(group.key)}</span>
+                  <ul className="fms-chips">{group.items.map((x) => <li key={x} className="is-missing">{x}</li>)}</ul>
+                </div>)}</td>
+            </tr>)}</tbody>
+          </table>}
+        </section>
+      </>;
+    }}</FmsBody>
+  </div>;
+}
diff --git a/viz-debugger/src/fms/views/FmsShell.tsx b/viz-debugger/src/fms/views/FmsShell.tsx
new file mode 100644
index 0000000..fbc8bca
--- /dev/null
+++ b/viz-debugger/src/fms/views/FmsShell.tsx
@@ -0,0 +1,107 @@
+/**
+ * src/fms/views/FmsShell.tsx (261105 — FMS 노드 다섯의 공통 틀)
+ *
+ * **비는 이유를 네 가지로 가른다.** 하나로 뭉치면 운영자가 다음에 무엇을 해야 하는지
+ * 알 수 없다.
+ *
+ *   주소 없음      연결 관리에 게이트웨이 주소가 비어 있다
+ *   못 읽었다      주소는 있는데 닿지 않거나 서버가 사유를 돌려줬다
+ *   권한 없다      닿았고 답도 받았는데 **그 일을 할 능력이 없다**(403 + 능력 이름)
+ *   받았는데 없다  정상이다 — 그 배치에 그 항목이 없다
+ *
+ * 마지막 하나를 「고장」으로 그리면 멀쩡한 배치가 깨진 것으로 보인다(AI-C-05).
+ */
+
+import { useLang } from '../../shared/language.ts';
+import { t } from '../../i18n/dict.ts';
+import type { ReactNode } from 'react';
+import type { FmsState } from '../useFms.ts';
+import { fmsContractVersion } from '../fmsApi.ts';
+import '../fms.css';
+
+/**
+ * 값 하나를 **안전하게** 그린다.
+ *
+ * **왜 있나**: 계약의 어떤 칸은 문자열처럼 보이지만 묶음이다 —
+ * `model.devices[].applied` 는 기능별 적용 버전의 **표**이고, 그것을 `{value}` 로
+ * 그렸더니 React 가 「객체는 자식이 될 수 없다」로 터져 **확대 전체가 빈 화면**이
+ * 됐다. 한 칸의 모양을 잘못 읽은 것이 화면 하나를 통째로 날린 것이다.
+ *
+ * 그래서 스칼라가 아니면 그리지 않고 `fallback` 을 낸다. 모양을 모르는 칸을
+ * 만나도 화면이 서 있는 쪽이, 터져서 아무것도 안 보이는 쪽보다 낫다.
+ */
+export function Scalar({ value, fallback }: { value: unknown; fallback?: ReactNode }) {
+  if (typeof value === 'string') return value === '' ? <>{fallback ?? '—'}</> : <>{value}</>;
+  if (typeof value === 'number' && Number.isFinite(value)) return <>{value}</>;
+  if (typeof value === 'boolean') return <>{String(value)}</>;
+  return <>{fallback ?? '—'}</>;
+}
+
+/** 경과를 사람이 읽는 꼴로. **한 번도 못 읽은 것과 오래된 것을 가른다.** */
+export function FmsAge({ readAt }: { readAt: number | null }) {
+  useLang();
+  if (readAt === null) return <span className="fms-state fms-state--unmeasured">{t('fms.neverRead')}</span>;
+  const age = Math.max(0, Math.round((Date.now() - readAt) / 1000));
+  return <span className="fms-hint">{t('fms.readAgo', { sec: age })}</span>;
+}
+
+/**
+ * 읽기 상태를 그린다. 본문이 있으면 `children` 을 부르고, 없으면 **그 이유**를 적는다.
+ *
+ * 본문이 있는데 사유도 있는 경우(한 번 받았고 다음 읽기가 실패) 둘을 **함께** 보인다 —
+ * 값을 지우면 「끊겼다」와 「없다」가 같아진다.
+ */
+export function FmsBody<T>({ state, children, card }: {
+  state: FmsState<T>;
+  children: (body: T) => ReactNode;
+  card?: boolean;
+}) {
+  useLang();
+  // 확대 쪽은 **겉 div 가 이미 `fms-zoom`** 이다. 여기서 또 `fms-zoom` 을 쓰면
+  // flex 묶음이 두 겹이 되고 사이 여백이 두 번 들어간다. 안쪽은 제 이름을 쓴다.
+  const wrap = card ? 'fms-card' : 'fms-zoom__body';
+  if (state.body === null) {
+    if (state.loading) return <div className={wrap}><p className="fms-empty">{t('fms.loading')}</p></div>;
+    if (state.needs !== null) {
+      return <div className={wrap}>
+        <p className="fms-empty">{t('fms.needsCapability', { cap: state.needs })}</p>
+        <p className="fms-hint">{t('fms.needsCapability.hint')}</p>
+      </div>;
+    }
+    if (state.error !== null) {
+      return <div className={wrap}>
+        <p className="fms-error">{state.error}</p>
+        <button type="button" onClick={state.reload}>{t('fms.reload')}</button>
+      </div>;
+    }
+    return <div className={wrap}><p className="fms-empty">{t('fms.noQuery')}</p></div>;
+  }
+  return <div className={wrap}>
+    {state.error !== null && <p className="fms-error">{t('fms.staleAfterError', { reason: state.error })}</p>}
+    {children(state.body)}
+  </div>;
+}
+
+/** 확대 머리 — 제목 · 계약 판 · 마지막 읽기 · 다시 읽기. */
+export function FmsHead<T>({ titleKey, state, extra }: {
+  titleKey: string; state: FmsState<T>; extra?: ReactNode;
+}) {
+  useLang();
+  const version = fmsContractVersion();
+  return <header className="fms-zoom__head">
+    <h3>{t(titleKey)}</h3>
+    {version !== null && <span className="fms-state fms-state--ok">{version}</span>}
+    <FmsAge readAt={state.readAt} />
+    <button type="button" onClick={state.reload} disabled={state.loading}>{t('fms.reload')}</button>
+    {extra}
+  </header>;
+}
+
+/**
+ * 「받았는데 없다」를 사유와 함께 적는다. 빈 목록을 그냥 비우면 **없는 것**과
+ * **볼 수 없는 것**이 구분되지 않는다.
+ */
+export function FmsNone({ messageKey }: { messageKey: string }) {
+  useLang();
+  return <p className="fms-empty">{t(messageKey)}</p>;
+}
diff --git a/viz-debugger/src/fms/views/FmsStack.tsx b/viz-debugger/src/fms/views/FmsStack.tsx
new file mode 100644
index 0000000..a176504
--- /dev/null
+++ b/viz-debugger/src/fms/views/FmsStack.tsx
@@ -0,0 +1,141 @@
+/**
+ * src/fms/views/FmsStack.tsx (261120 신설 — 백엔드 스택을 **여기서** 켠다)
+ *
+ * ## 왜 있나
+ *
+ * 지금까지 운영은 이렇게 돌았다 — 이 화면에서 결정하고, **백엔드 기계 앞에 앉은
+ * 사람이** `make up` 과 `python server_stream_multi_source.py` 를 손으로 친다.
+ * 운영자가 둘이 되고, 둘 중 한 명은 화면을 보지 못한다.
+ *
+ * 그 기계에서 사람이 하는 일은 이제 하나다: **백엔드를 켜 두는가.** 그 다음의
+ * 전송 스택·실증 스트림·추론은 여기서 켜고 끈다(`POST /api/stack`).
+ *
+ * ## 보내는 것은 **이름뿐**이다
+ *
+ * 저쪽은 명령줄을 받지 않는다. 받으면 쓰기 계약 하나가 원격 코드 실행 창구가 되기
+ * 때문이고, 그래서 이 화면에도 "명령을 입력" 하는 칸이 없다 — 저쪽 기계의 선언에
+ * 적힌 단위를 **고르기만** 한다. 목록에 없는 것은 여기서 만들 수 없다.
+ *
+ * ## 네 가지를 각각 그린다
+ *
+ *   status      제어면이 본 프로세스 상태(RUNNING · STOPPED)
+ *   ready       **그것과 다른 축이다** — 떠 있지만 준비 안 된 상태가 정상으로 있다.
+ *               `null` 은 묻지 않았다(포트를 선언하지 않은 단위)이고 거짓이 아니다
+ *   exit_code   끝났으면 그 코드. `null` 은 돌고 있다 **또는** 띄운 적 없다이고 0 이 아니다
+ *   last_output 왜 멈췄는지. 이것이 없으면 "눌렀는데 아무 일도 없다" 만 보이고
+ *               사유는 저쪽 기계의 로그 파일 안에 남는다 — 그 기계에 들어가지
+ *               않으려고 만든 계약이 그 기계에 들어가게 만든다
+ */
+
+import { useCallback, useState } from 'react';
+import { useLang } from '../../shared/language.ts';
+import { t } from '../../i18n/dict.ts';
+import { useFms } from '../useFms.ts';
+import { fmsStack, localized, type FmsServices, type FmsUnit } from '../fmsApi.ts';
+import { FmsAge, FmsBody, FmsHead } from './FmsShell.tsx';
+import '../fms.css';
+
+/** 상태 한 칸. **세 값을 세 가지로** 그린다 — 미측정을 거짓으로 칠하지 않는다. */
+function Ready({ value }: { value: boolean | null }) {
+  useLang();
+  if (value === null) {
+    return <span className="fms-state fms-state--unmeasured">{t('fms.stack.unmeasured')}</span>;
+  }
+  return <span className={value ? 'fms-state fms-state--ok' : 'fms-state fms-state--warn'}>
+    {value ? t('fms.stack.ready') : t('fms.stack.notReady')}
+  </span>;
+}
+
+function UnitRow({ unit, onDone }: { unit: FmsUnit; onDone: () => void }) {
+  const lang = useLang();
+  const [busy, setBusy] = useState<string | null>(null);
+  const [said, setSaid] = useState<string | null>(null);
+  const running = unit.status === 'RUNNING';
+
+  const operate = useCallback(async (action: 'start' | 'stop' | 'restart') => {
+    setBusy(action);
+    setSaid(null);
+    const outcome = await fmsStack(unit.unit_id, action);
+    setBusy(null);
+    if (!outcome.ok) {
+      setSaid(outcome.error);
+      return;
+    }
+    // **수락은 성공이고 거절도 답이다.** 사유 토큰을 그대로 보인다 — 번역해 뭉개면
+    // `dependency_not_running:data-stream-redis` 의 뒷부분(무엇이 막았나)이 사라진다.
+    setSaid(outcome.body.accepted ? null : outcome.body.reason);
+    onDone();
+  }, [unit.unit_id, onDone]);
+
+  return <div className="fms-row">
+    <div className="fms-row__head">
+      <strong>{localized(unit.label, lang) ?? unit.unit_id}</strong>
+      <span className="fms-hint">{unit.unit_id} · {unit.kind}</span>
+    </div>
+    <div className="fms-row__state">
+      <span className={running ? 'fms-state fms-state--ok' : 'fms-state'}>{unit.status}</span>
+      <Ready value={unit.ready} />
+      {unit.exit_code !== null && <span className="fms-hint">exit {unit.exit_code}</span>}
+      {unit.depends_on.length > 0
+        && <span className="fms-hint">{t('fms.stack.needs', { units: unit.depends_on.join(', ') })}</span>}
+    </div>
+    {unit.last_output !== null && <p className="fms-hint fms-row__log">{unit.last_output}</p>}
+    {said !== null && <p className="fms-error">{said}</p>}
+    <div className="fms-row__acts">
+      <button type="button" disabled={busy !== null || running}
+              onClick={() => void operate('start')}>
+        {busy === 'start' ? t('fms.stack.working') : t('fms.stack.start')}
+      </button>
+      <button type="button" disabled={busy !== null || !running}
+              onClick={() => void operate('stop')}>
+        {busy === 'stop' ? t('fms.stack.working') : t('fms.stack.stop')}
+      </button>
+      <button type="button" disabled={busy !== null}
+              onClick={() => void operate('restart')}>
+        {t('fms.stack.restart')}
+      </button>
+    </div>
+  </div>;
+}
+
+function Units({ body, onDone }: { body: FmsServices; onDone: () => void }) {
+  useLang();
+  if (!body.configured) {
+    // **빈 목록과 다른 사실이다.** "띄울 것이 없다" 와 "이 설치는 띄우지 않는다" 를
+    // 같게 그리면 운영자가 선언 파일을 찾아 헤맨다.
+    return <p className="fms-empty">{t('fms.stack.notConfigured', { reason: body.reason ?? '—' })}</p>;
+  }
+  if (body.units.length === 0) return <p className="fms-empty">{t('fms.stack.none')}</p>;
+  return <>{body.units.map((unit) => (
+    <UnitRow key={unit.unit_id} unit={unit} onDone={onDone} />
+  ))}</>;
+}
+
+export function FmsStackCard() {
+  useLang();
+  const state = useFms<FmsServices>('/api/services');
+  return <FmsBody state={state} card>{(body) => <>
+    <div className="fms-card__line">
+      <b>{t('viewnode.fmsStack')}</b>
+      <FmsAge readAt={state.readAt} />
+    </div>
+    {!body.configured
+      ? <p className="fms-empty">{t('fms.stack.notConfigured', { reason: body.reason ?? '—' })}</p>
+      : <div className="fms-card__line">
+          <span className="fms-num">{body.units.filter((u) => u.status === 'RUNNING').length}</span>
+          <span className="fms-hint">{t('fms.stack.summary', { all: body.units.length })}</span>
+        </div>}
+  </>}</FmsBody>;
+}
+
+export function FmsStackZoom() {
+  useLang();
+  const state = useFms<FmsServices>('/api/services');
+  return <div className="fms-zoom">
+    <FmsHead titleKey="viewnode.fmsStack" state={state} />
+    <FmsBody state={state}>{(body) => (
+      <Units body={body} onDone={state.reload} />
+    )}</FmsBody>
+    <p className="fms-hint">{t('fms.stack.boundary')}</p>
+  </div>;
+}
diff --git a/viz-debugger/src/fms/views/FmsTiers.tsx b/viz-debugger/src/fms/views/FmsTiers.tsx
new file mode 100644
index 0000000..9677a98
--- /dev/null
+++ b/viz-debugger/src/fms/views/FmsTiers.tsx
@@ -0,0 +1,461 @@
+/**
+ * src/fms/views/FmsTiers.tsx (261105 — 계층별 자원·서비스 지표 · 장치 관리)
+ *
+ * **미측정은 0 도 미달도 아니다**(AI-O-05). 측정값이 없는 자리에 0 을 채우면 유휴와
+ * 고장이 같아지고, 배치된 기능이 없는 가속기를 목록에서 빼면 「없는 것」과 「쉬는
+ * 것」이 같아진다. 그래서 값이 없으면 **없다고 적는다.**
+ *
+ * 하드웨어 계층과 서비스 계층을 **한 목록에 섞지 않는다.** 서비스 줄에는 그것이 도는
+ * 가속기를 함께 적는다.
+ */
+
+import { useLang } from '../../shared/language.ts';
+import { t } from '../../i18n/dict.ts';
+import { useFms } from '../useFms.ts';
+import { FmsBody, FmsHead, FmsNone, Scalar } from './FmsShell.tsx';
+
+/**
+ * **칸 이름은 짐작하지 않는다.** 아래 모양의 정본은
+ * `schemas/ai/status-snapshot.schema.json`(허브 `view_snapshot` 이 그것을 참조한다)
+ * 이고, 여기 적힌 이름은 거기서 그대로 가져온 것이다.
+ *
+ * 2026-11-06 에 실제로 틀렸던 자리를 남겨 둔다 — 이 파일은 `accelerator_id` ·
+ * `temperature_c` · `node_id` · `service_count` · `latency_ms` 를 읽고 있었고
+ * **그런 칸은 계약에 없다.** 오류도 경고도 나지 않고 표만 전부 「미측정」·빈칸이
+ * 됐다. 200 · 시험 통과 · 빈 화면이 함께 나는 그 갈래다.
+ */
+type Measurement = {
+  /** **칸이 없으면 측정 없음**이다. 0 을 넣으면 "쟀더니 0" 과 구분되지 않는다. */
+  value?: number | null;
+  unit?: string | null;
+  measured_at?: string | null;
+  /** `measured` · `declared` · `unavailable`. 서버가 덧붙이는 칸이다. */
+  measurement_source?: string | null;
+};
+
+type Accelerator = {
+  accelerator_instance_id: string;
+  accelerator_kind: string;
+  accelerator_attachment?: string | null;
+  accelerator_vendor_label?: string | null;
+  utilization?: Measurement | null;
+  temperature?: Measurement | null;
+};
+
+type Indicator = {
+  indicator_name: string;
+  measurement?: Measurement | null;
+  target?: { value?: number | null; unit?: string | null; direction?: string | null } | null;
+  target_meet_state?: string | null;
+};
+
+type ServiceRow = {
+  service_id: string;
+  accelerator_instance_id?: string | null;
+  service_role?: string | null;
+  model?: string | null;
+  model_version?: string | null;
+  indicators?: readonly Indicator[];
+};
+
+/** 보드는 **이름 있는 두 칸**이다. `host_probe_id` 는 계측 지점의 이름이고 측정이 아니다. */
+type Board = {
+  memory_utilization?: Measurement | null;
+  power?: Measurement | null;
+  host_probe_id?: string | null;
+};
+
+type Region = { region_id: string; region_available?: boolean | null; region_reason?: string | null; missing_sources?: readonly string[] | null };
+
+/**
+ * 세면 나오는 값들. **화면이 다시 세지 않는다**(view-contract §3.6 — 한 사실에
+ * 주인은 하나). 특히 실측·선언·미측정 셋은 서로의 여집합이 아니다: 선언된 숫자만
+ * 있는 개체는 실측 목록에도 미측정 목록에도 들지 않는다.
+ */
+type Derived = {
+  accelerator_placement?: Record<string, readonly string[]> | null;
+  idle_accelerator_instance_ids?: readonly string[] | null;
+  unmeasured_accelerator_instance_ids?: readonly string[] | null;
+  measured_accelerator_instance_ids?: readonly string[] | null;
+  not_measured_indicator_names?: readonly string[] | null;
+  unmet_indicator_names?: readonly string[] | null;
+};
+
+type Dashboard = {
+  accelerators?: readonly Accelerator[];
+  services?: readonly ServiceRow[];
+  regions?: readonly Region[];
+  board?: Board | null;
+  derived?: Derived | null;
+  sources?: readonly { source_id: string; received?: boolean | null; last_seen_age_s?: number | null }[];
+  task_nodes?: readonly unknown[];
+};
+
+/** 세 상태. **값이 없는 것이 세 번째다** — `null` 을 0 으로 접지 않는다. */
+function MeasureCell({ measure }: { measure: Measurement | null | undefined }) {
+  useLang();
+  if (measure === null || measure === undefined || measure.value === null || measure.value === undefined) {
+    return <span className="fms-state fms-state--unmeasured">{t('fms.unmeasured')}</span>;
+  }
+  const unit = measure.unit ?? '';
+  return <span className="fms-num">{measure.value.toFixed(unit === 'ratio' ? 2 : 1)}{unit === '' ? '' : ` ${unit}`}</span>;
+}
+
+/**
+ * 이 숫자가 **어디서 왔는지**를 적는다. 목 선언과 실측을 같은 글씨로 그리면
+ * 화면은 채워지지만 무엇이 실제로 측정된 값인지 알 수 없다(AI-O-05·AI-B-01).
+ */
+function SourceChip({ id, derived }: { id: string; derived: Derived }) {
+  useLang();
+  if ((derived.measured_accelerator_instance_ids ?? []).includes(id)) {
+    return <span className="fms-state fms-state--ok">{t('fms.tiers.measured')}</span>;
+  }
+  if ((derived.unmeasured_accelerator_instance_ids ?? []).includes(id)) {
+    return <span className="fms-state fms-state--unmeasured">{t('fms.unmeasured')}</span>;
+  }
+  return <span className="fms-state fms-state--warn">{t('fms.tiers.declared')}</span>;
+}
+
+/** `MET` · `UNMET` · `NOT_MEASURED`. **미측정은 미달이 아니다**(§4.5). */
+function MeetChip({ meet }: { meet: string | null | undefined }) {
+  useLang();
+  if (meet === 'MET') return <span className="fms-state fms-state--ok">{t('fms.tiers.meets')}</span>;
+  if (meet === 'UNMET') return <span className="fms-state fms-state--bad">{t('fms.tiers.misses')}</span>;
+  return <span className="fms-state fms-state--unmeasured">{t('fms.unmeasured')}</span>;
+}
+
+export function FmsTiersCard() {
+  useLang();
+  const state = useFms<Dashboard>('/api/dashboard');
+  return <FmsBody state={state} card>{(body) => {
+    const accelerators = body.accelerators ?? [];
+    const services = body.services ?? [];
+    const regions = body.regions ?? [];
+    const derived = body.derived ?? {};
+    // **세지 않고 받는다.** 서버가 이미 센 값이 있고, 화면이 다시 세면 두 곳이
+    // 갈라진다(view-contract §3.6). 그리고 셋은 서로의 여집합이 **아니다** —
+    // 선언만 있는 개체는 실측에도 미측정에도 들지 않는다.
+    const measured = (derived.measured_accelerator_instance_ids ?? []).length;
+    const unmeasured = (derived.unmeasured_accelerator_instance_ids ?? []).length;
+    const declared = Math.max(0, accelerators.length - measured - unmeasured);
+    const idle = (derived.idle_accelerator_instance_ids ?? []).length;
+    const missing = regions.filter((r) => r.region_available === false).length;
+    return <>
+      <div className="fms-card__line">
+        <b>{t('fms.tiers.accelerators')}</b><span className="fms-num">{accelerators.length}</span>
+        <span className="fms-state fms-state--ok">{t('fms.tiers.measuredN', { n: measured })}</span>
+        {declared > 0 && <span className="fms-state fms-state--warn">{t('fms.tiers.declaredN', { n: declared })}</span>}
+        {unmeasured > 0 && <span className="fms-state fms-state--unmeasured">{t('fms.tiers.unmeasuredN', { n: unmeasured })}</span>}
+      </div>
+      <div className="fms-card__line">
+        <b>{t('fms.tiers.services')}</b><span className="fms-num">{services.length}</span>
+        {/* 배치가 없는 가속기를 **목록에서 빼지 않는다** — 유휴와 없음은 다르다. */}
+        {idle > 0 && <span className="fms-hint">{t('fms.tiers.idleN', { n: idle })}</span>}
+      </div>
+      <div className="fms-card__line">
+        <b>{t('fms.tiers.regions')}</b>
+        <span className="fms-num">{regions.length}</span>
+        {missing > 0 && <span className="fms-state fms-state--bad">{t('fms.tiers.regionsMissing', { n: missing })}</span>}
+      </div>
+      {accelerators.length === 0 && services.length === 0 && <FmsNone messageKey="fms.tiers.none" />}
+    </>;
+  }}</FmsBody>;
+}
