+                {typeof s.model === 'string' && s.model !== '' && <span className="fms-hint"> · {s.model}
+                  {typeof s.model_version === 'string' ? ` ${s.model_version}` : ''}</span>}
+              </td>
+              {/* 서비스 줄에 **그것이 도는 가속기**를 함께 적는다(AI-O-05). */}
+              <td><Scalar value={s.accelerator_instance_id}
+                          fallback={<span className="fms-state fms-state--unmeasured">{t('fms.unmeasured')}</span>} /></td>
+              <td>{(s.indicators ?? []).length === 0
+                ? <span className="fms-hint">{t('fms.tiers.noIndicators')}</span>
+                : <table className="fms-table fms-table--inner"><tbody>{(s.indicators ?? []).map((ind) => <tr key={ind.indicator_name}>
+                    <th>{ind.indicator_name}</th>
+                    <td><MeasureCell measure={ind.measurement} /></td>
+                    <td>{ind.target !== null && ind.target !== undefined && typeof ind.target.value === 'number'
+                      ? <span className="fms-hint">{t('fms.tiers.target', {
+                          dir: ind.target.direction ?? '', value: ind.target.value.toFixed(1), unit: ind.target.unit ?? '' })}</span>
+                      : <span className="fms-hint">—</span>}</td>
