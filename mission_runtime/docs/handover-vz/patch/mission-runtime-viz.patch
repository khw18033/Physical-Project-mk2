@@ -0,0 +1,67 @@
+/**
+ * src/fms/useFms.ts (261105 — FMS 조회를 노드가 쓰는 꼴로)
+ *
+ * **열 때 한 번, 그 뒤는 누를 때만.** 간격 폴링을 두지 않는다 — 저쪽 계약의 규칙과
+ * 같다(AI-C-13: 아무도 보지 않는 구역을 상시 갱신하면 그 구역의 추론·전송까지 계속
+ * 돈다). 카드를 넷 놓았다고 폴링이 넷 돌지 않는다.
+ *
+ * **마지막으로 읽은 시각을 들고 있는다.** 「한 번도 못 읽었다」와 「읽었지만
+ * 오래됐다」는 다른 상태이고, 화면이 그 둘을 같은 빈칸으로 그리면 안 된다.
+ */
+
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { readFms, type FmsRead } from './fmsApi.ts';
+
+export type FmsState<T> = {
+  /** 받은 본문. 한 번도 못 받았으면 null. */
+  body: T | null;
+  /** 실패 사유(통제 어휘 토큰). 성공했으면 null. */
+  error: string | null;
+  /** `missing_permission:<능력>` 이었을 때 그 능력 이름. */
+  needs: string | null;
+  status: number | null;
+  loading: boolean;
+  /** 마지막으로 **성공한** 읽기 시각(ms). 한 번도 없으면 null. */
+  readAt: number | null;
+  reload: () => void;
+};
+
+/**
+ * `path` 가 null 이면 읽지 않는다 — 인자가 아직 안 정해진 노드(로봇을 안 고른 추천
+ * 카드 등)가 **없는 질의를 던지지 않게** 한다. 그 자리에는 「무엇을 골라야 하는지」가
+ * 뜨고, 「읽기 실패」가 뜨지 않는다.
+ */
+export function useFms<T>(path: string | null): FmsState<T> {
+  const [state, setState] = useState<Omit<FmsState<T>, 'reload'>>({
+    body: null, error: null, needs: null, status: null, loading: path !== null, readAt: null,
+  });
+  const [nonce, setNonce] = useState(0);
+  const alive = useRef(true);
+
+  useEffect(() => {
+    alive.current = true;
+    return () => { alive.current = false; };
+  }, []);
+
+  useEffect(() => {
+    if (path === null) {
+      setState({ body: null, error: null, needs: null, status: null, loading: false, readAt: null });
+      return;
+    }
+    const abort = new AbortController();
+    setState((prev) => ({ ...prev, loading: true }));
+    void (async () => {
+      const outcome: FmsRead<T> = await readFms<T>(path, abort.signal);
+      if (!alive.current || abort.signal.aborted) return;
+      setState((prev) => outcome.ok
+        ? { body: outcome.body, error: null, needs: null, status: 200, loading: false, readAt: Date.now() }
+        // **마지막으로 읽은 것을 버리지 않는다.** 한 번 실패했다고 화면이 비면
+        // 「끊겼다」와 「없다」가 같아진다.
+        : { body: prev.body, error: outcome.error, needs: outcome.needs, status: outcome.status, loading: false, readAt: prev.readAt });
+    })();
+    return () => { abort.abort(); };
+  }, [path, nonce]);
+
+  const reload = useCallback(() => { setNonce((n) => n + 1); }, []);
+  return { ...state, reload };
+}
