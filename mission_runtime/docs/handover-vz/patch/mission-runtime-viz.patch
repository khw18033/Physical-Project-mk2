+      <section>
+        <h4>{t('fms.deploy.devices')}</h4>
+        {(body.model?.devices ?? []).length === 0 ? <FmsNone messageKey="fms.deploy.noDevices" /> : <table className="fms-table">
+          <thead><tr><th>{t('fms.deploy.device')}</th><th>{t('fms.deploy.hwTags')}</th><th>{t('fms.deploy.memoryBudget')}</th><th>{t('fms.deploy.applied')}</th></tr></thead>
+          <tbody>{(body.model?.devices ?? []).map((d) => <tr key={d.device_id}>
+            <td><Scalar value={d.device_id} /></td>
+            <td><ul className="fms-chips">{(d.hw_tags ?? []).map((x) => <li key={x}>{x}</li>)}</ul></td>
+            {/* **설치 용량이 아니라 선언된 예산이다.** 선언이 없는 노드는 서버가
+                0 으로 낸다(`ResourceBudget(memory_mb=0.0)`) — 그 0 은 "0MB 짜리
+                기계" 가 아니라 "예산을 선언하지 않았다" 는 뜻이고, 배치 계산에서는
+                아무것도 들어가지 못한다는 뜻이 된다. 여기서 그 0 을 「미선언」으로
+                바꿔 적지 않는다 — 그 사실의 주인은 서버다(view-contract §3.6). */}
+            <td className="fms-num"><Scalar value={d.memory_mb} /></td>
+            <td>{Object.keys(d.applied ?? {}).length === 0
+              ? <span className="fms-hint">{t('fms.deploy.notApplied')}</span>
+              : <ul className="fms-chips">{Object.entries(d.applied ?? {}).map(([kind, ref]) => <li key={kind}>
+                  {kind}: <Scalar value={ref} />
+                </li>)}</ul>}</td>
+          </tr>)}</tbody>
+        </table>}
+      </section>
+    </>}</FmsBody>
+  </div>;
+}
diff --git a/viz-debugger/src/fms/views/FmsTwin.tsx b/viz-debugger/src/fms/views/FmsTwin.tsx
new file mode 100644
index 0000000..8fd0a2e
--- /dev/null
+++ b/viz-debugger/src/fms/views/FmsTwin.tsx
@@ -0,0 +1,283 @@
+/**
+ * src/fms/views/FmsTwin.tsx (261105 — 디지털 트윈 맵 노드)
+ *
+ * **맵은 데이터와 렌더러가 갈려 있다.** 서버 응답(`/api/scene` · `/api/domain` ·
+ * `/api/zone`)에는 색·픽셀·폰트가 없고 자리와 상태만 있다. 이 파일이 렌더러 하나이고,
+ * 3D 뷰어가 생기면 **같은 응답을 읽어** 그리면 된다.
+ *
+ * 드릴은 현장 → 도메인 → 구역이다. 요약 카드는 **확대하지 않고도 이상함을 알아챌 수
+ * 있는 값**을 담는다 — 도메인 수가 아니라 「공지로 탐지된 로봇 n/N」과 「도면이
+ * 검증되지 않은 구역 수」다.
+ */
+
+import { useState } from 'react';
+import { useLang } from '../../shared/language.ts';
+import { t } from '../../i18n/dict.ts';
+import { useFms } from '../useFms.ts';
+import { FmsBody, FmsHead, FmsNone } from './FmsShell.tsx';
+import { localized } from '../fmsApi.ts';
+
+/**
+ * 구역·도메인 한 칸의 자리. **이름은 `w`·`h` 다** — `width`·`height` 가 아니다
+ * (`schemas/view_snapshot.schema.json` 의 `rect` 가 `["x","y","w","h"]` 를 required 로
+ * 적는다). 처음에 `width`/`height` 로 읽어서 `<rect>` 에 `undefined` 가 들어갔고,
+ * 도면이 **아무 오류 없이 빈 상자**로 나왔다 — 계약의 이름을 지어내면 이렇게
+ * 조용히 틀린다.
+ */
+type Rect = { x: number; y: number; w: number; h: number };
+
+type SceneDomain = {
+  domain_id: string;
+  /** **묶음일 수 있다** — 계약이 도메인·구역의 `label` 을 언어별로 적는다. */
+  label?: unknown;
+  site?: string | null;
+  example?: boolean;
+  rect?: Rect | null;
+};
+
+type Scene = {
+  space?: { origin?: { x: number; y: number }; width?: number; height?: number; unit?: string; datum_id?: string | null } | null;
+  domains?: readonly SceneDomain[];
+  map_tiles?: { declared?: boolean; closed_network?: boolean; layers?: readonly { layer_id: string; label?: string | null; enabled?: boolean; available?: boolean; requires_external_connection?: boolean }[] } | null;
+};
+
+type ZoneRobot = {
+  node_id: string;
+  role?: string | null;
+  /** 로봇의 `label` 은 **평평한 문자열**이다(view-contract §8) — 묶음이 아니다. */
+  label?: string | null;
+  presence?: string | null;
+  last_seen_age_s?: number | null;
+  verified?: boolean;
+  /** 자리. **없을 수 있다**(`null`) — 그때는 그리지 않는다. */
+  at?: { x?: number; y?: number } | null;
+  /** 그 자리가 **어디서 왔나**. 칸이 없으면 선언이다(AI-C-02). */
+  at_origin?: string | null;
+  /** 지금 `at` 에 든 값을 **무엇이 만들었나**. `null` 이면 선언이다. */
+  position_source?: string | null;
+};
+
+type Zone = {
+  zone_id: string;
+  /** 묶음일 수 있다(§8). */
+  label?: unknown;
+  level_id?: string | null;
+  state?: string | null;
+  reachable?: boolean | null;
+  verified?: boolean;
+  declared_count?: number;
+  discovered_count?: number;
+  unexpected_count?: number;
+  rect?: Rect | null;
+  robots?: readonly ZoneRobot[];
+  infrastructure?: readonly { kind?: string | null; label?: string | null; presence?: string | null }[];
+  usable_functions?: readonly string[];
+};
+
+type Domain = { domain_id: string; label?: unknown; zones?: readonly Zone[]; site?: string | null };
+
+/**
+ * 존재는 **세 값이다** — `discovered`(선언됐고 공지도 왔다) · `declared`(선언만
+ * 있다) · `unexpected`(공지는 왔는데 선언에 없다). 선언을 탐지로 바꿔 읽지 않는다.
+ */
+const PRESENCE_TONE: Record<string, 'ok' | 'warn' | 'bad'> = {
+  discovered: 'ok', declared: 'warn', unexpected: 'bad',
+};
+
+/**
+ * **서버가 이미 센 것을 쓴다.** 여기서 로봇을 다시 세면 같은 사실에 주인이 둘이
+ * 되고, 실제로 그렇게 어긋났다 — 카드는 「탐지 0」인데 바로 아래 표는 「탐지 2」였다
+ * (내 쪽 어휘가 `present` 였다). 세는 규칙은 저쪽 것 하나다.
+ */
+function zoneTotals(zones: readonly Zone[]): { seen: number; declared: number } {
+  let seen = 0;
+  let declared = 0;
+  for (const zone of zones) {
+    seen += zone.discovered_count ?? 0;
+    declared += zone.declared_count ?? 0;
+  }
+  return { seen, declared };
+}
+
+export function FmsTwinCard() {
+  useLang();
+  const scene = useFms<Scene>('/api/scene');
+  return <FmsBody state={scene} card>{(body) => {
+    const domains = body.domains ?? [];
+    const tiles = body.map_tiles;
+    const layers = tiles?.layers ?? [];
+    const usable = layers.filter((l) => l.available === true).length;
+    const datum = body.space?.datum_id ?? null;
+    return <>
+      <div className="fms-card__line">
+        <b>{t('fms.twin.domains')}</b>
+        <span className="fms-num">{domains.length}</span>
+        {domains.some((d) => d.example === true) && <span className="fms-state fms-state--warn">{t('fms.twin.hasExample')}</span>}
+      </div>
+      <div className="fms-card__line">
+        <b>{t('fms.twin.tiles')}</b>
+        {tiles?.declared === true
+          ? <span className="fms-num">{t('fms.twin.tileCount', { usable, total: layers.length })}</span>
+          : <span className="fms-state fms-state--unmeasured">{t('fms.twin.noTiles')}</span>}
+        {tiles?.closed_network === true && <span className="fms-state fms-state--ok">{t('fms.twin.closed')}</span>}
+      </div>
+      <div className="fms-card__line">
+        <b>{t('fms.twin.datum')}</b>
+        {/* datum 이 없는 현장은 **정상 상태**다 — 전역 계층만 비활성이고 로컬 판단은
+            그대로 돈다(AI-C-02). 「없음」을 고장으로 그리지 않는다. */}
+        {datum === null || datum === ''
+          ? <span className="fms-state fms-state--unmeasured">{t('fms.twin.noDatum')}</span>
+          : <span>{datum}</span>}
+      </div>
+      {domains.length === 0 && <FmsNone messageKey="fms.twin.none" />}
+    </>;
+  }}</FmsBody>;
+}
+
+export function FmsTwinZoom() {
+  const lang = useLang();
+  const scene = useFms<Scene>('/api/scene');
+  const [domainId, setDomainId] = useState<string | null>(null);
+  const first = scene.body?.domains?.[0]?.domain_id ?? null;
+  const chosen = domainId ?? first;
+  const domain = useFms<Domain>(chosen === null ? null : `/api/domain?id=${encodeURIComponent(chosen)}`);
+  const [zoneId, setZoneId] = useState<string | null>(null);
+  const zones = domain.body?.zones ?? [];
+  const chosenZone = zoneId ?? zones[0]?.zone_id ?? null;
+  const zone = useFms<Zone>(chosenZone === null ? null : `/api/zone?id=${encodeURIComponent(chosenZone)}`);
+
+  return <div className="fms-zoom">
+    <FmsHead titleKey="viewnode.fmsTwin" state={scene} extra={
+      <span className="fms-actions">
+        <select value={chosen ?? ''} onChange={(e) => { setDomainId(e.target.value); setZoneId(null); }}>
+          {(scene.body?.domains ?? []).map((d) => <option key={d.domain_id} value={d.domain_id}>
+            {localized(d.label, lang) ?? d.domain_id}{d.example === true ? ` (${t('fms.twin.example')})` : ''}
+          </option>)}
+        </select>
+        <select value={chosenZone ?? ''} onChange={(e) => setZoneId(e.target.value)}>
+          {zones.map((z) => <option key={z.zone_id} value={z.zone_id}>{localized(z.label, lang) ?? z.zone_id}</option>)}
+        </select>
+      </span>
+    } />
+
+    <FmsBody state={domain}>{(body) => {
+      const list = body.zones ?? [];
+      const { seen, declared } = zoneTotals(list);
+      return <section>
+        <h4>{t('fms.twin.zones')}</h4>
+        <p className="fms-card__line">
+          <span>{t('fms.twin.zoneCount', { n: list.length })}</span>
+          <span>{t('fms.twin.seenOfDeclared', { seen, declared })}</span>
+        </p>
+        <ZoneMap zones={list} />
+        {withoutPlace(list).missing > 0 && <p className="fms-hint">
+          {t('fms.twin.noPositions', withoutPlace(list))}
+        </p>}
+        <table className="fms-table">
+          <thead><tr>
+            <th>{t('fms.twin.zone')}</th><th>{t('fms.twin.state')}</th>
+            <th>{t('fms.twin.declared')}</th><th>{t('fms.twin.discovered')}</th>
+            <th>{t('fms.twin.unexpected')}</th>
+          </tr></thead>
+          <tbody>{list.map((z) => <tr key={z.zone_id} className={z.unexpected_count ? 'is-blocked' : ''}>
+            <td>{localized(z.label, lang) ?? z.zone_id}{z.verified === false && <em> {t('fms.twin.unverified')}</em>}</td>
+            <td>{z.state ?? '—'}</td>
+            <td className="fms-num">{z.declared_count ?? '—'}</td>
+            <td className="fms-num">{z.discovered_count ?? '—'}</td>
+            <td className="fms-num">{z.unexpected_count ?? '—'}</td>
+          </tr>)}</tbody>
+        </table>
+        {list.length === 0 && <FmsNone messageKey="fms.twin.noZones" />}
+      </section>;
+    }}</FmsBody>
+
+    <FmsBody state={zone}>{(body) => {
+      const robots = body.robots ?? [];
+      return <section>
+        <h4>{localized(body.label, lang) ?? body.zone_id}</h4>
+        {robots.length === 0 ? <FmsNone messageKey="fms.twin.noRobots" /> : <table className="fms-table">
+          <thead><tr>
+            <th>{t('fms.twin.robot')}</th><th>{t('fms.twin.role')}</th>
+            <th>{t('fms.twin.presence')}</th><th>{t('fms.twin.lastSeen')}</th>
+          </tr></thead>
+          <tbody>{robots.map((r) => <tr key={r.node_id}>
+            <td>{r.label ?? r.node_id}</td>
+            <td>{r.role ?? '—'}</td>
+            <td><span className={`fms-state fms-state--${
+              r.presence === undefined || r.presence === null ? 'unmeasured'
+                : PRESENCE_TONE[r.presence] ?? 'warn'}`}>
+              {r.presence ?? t('fms.unmeasured')}
+            </span></td>
+            {/* 한 번도 공지하지 않은 것과 오래된 것은 다른 상태다(AI-O-05). */}
+            <td>{r.last_seen_age_s === null || r.last_seen_age_s === undefined
+              ? <span className="fms-state fms-state--unmeasured">{t('fms.neverRead')}</span>
+              : t('fms.ageSec', { sec: r.last_seen_age_s.toFixed(0) })}</td>
+          </tr>)}</tbody>
+        </table>}
+        <ul className="fms-chips">
+          {(body.usable_functions ?? []).map((f) => <li key={f}>{f}</li>)}
+        </ul>
+      </section>;
+    }}</FmsBody>
+  </div>;
+}
+
+/**
+ * 구역 도면. **서버가 준 사각형을 그대로 쓴다** — 자리를 여기서 계산하면 같은 사실에
+ * 주인이 둘이 된다. 좌표계는 구역 로컬이고 전역 값과 같은 칸에 담지 않는다(AI-C-02).
+ */
+function ZoneMap({ zones }: { zones: readonly Zone[] }) {
+  const lang = useLang();
+  const boxes = zones.filter((z): z is Zone & { rect: Rect } => z.rect !== null && z.rect !== undefined);
+  if (boxes.length === 0) return <p className="fms-hint">{t('fms.twin.noRect')}</p>;
+  const minX = Math.min(...boxes.map((z) => z.rect.x));
+  const minY = Math.min(...boxes.map((z) => z.rect.y));
+  const maxX = Math.max(...boxes.map((z) => z.rect.x + z.rect.w));
+  const maxY = Math.max(...boxes.map((z) => z.rect.y + z.rect.h));
+  // 여백은 도면 크기에 비례해야 한다 — 고정 2 m 는 50 m 구역에서는 보이지도 않고
+  // 5 m 구역에서는 그림을 반으로 줄인다.
+  const pad = Math.max(1, (maxX - minX + maxY - minY) * 0.02);
+  const span = Math.max(maxX - minX, maxY - minY);
+  const dot = Math.max(0.6, span * 0.018);
+  return <svg className="fms-map" viewBox={`${minX - pad} ${minY - pad} ${maxX - minX + pad * 2} ${maxY - minY + pad * 2}`}
+       role="img" aria-label={t('fms.twin.mapLabel')}>
+    {boxes.map((z) => <g key={z.zone_id}>
+      <rect className={`fms-map__zone${z.verified === false ? ' fms-map__zone--unverified' : ''}`}
+            strokeWidth={Math.max(0.2, span * 0.004)}
+            strokeDasharray={z.verified === false ? `${span * 0.02} ${span * 0.012}` : undefined}
+            x={z.rect.x} y={z.rect.y} width={z.rect.w} height={z.rect.h} />
+      <text className="fms-map__label" x={z.rect.x + pad} y={z.rect.y + pad * 3}
+            style={{ fontSize: `${Math.max(1.2, span * 0.03)}px` }}>{localized(z.label, lang) ?? z.zone_id}</text>
+      {/* **자리가 없는 로봇은 그리지 않는다.** 전에는 구역 안에 차례로 찍었는데,
+          그것은 보고되지 않은 자리를 지어내는 것이다 — 보는 사람은 그 점을 실제
+          위치로 읽는다(AI-C-02: 없으면 없다고 둔다).
+
+          그리는 것도 **선언된 자리와 보고된 자리를 가른다.** `position_source` 가
+          없으면 그 값은 선언에서 온 것이고, 그것을 채운 점으로 그리면 「장치가
+          거기 있다고 보고했다」로 읽힌다 — AI-C-02 가 이름 붙인 바로 그 결함이다.
+          선언은 속이 빈 점선 동그라미다. */}
+      {(z.robots ?? []).map((r) => {
+        if (r.at?.x === undefined || r.at?.y === undefined) return null;
+        const reported = r.position_source !== null && r.position_source !== undefined;
+        return <circle key={r.node_id}
+          className={'fms-map__robot'
+            + (reported ? '' : ' fms-map__robot--declared')
+            + (r.presence === 'discovered' ? '' : ' fms-map__robot--absent')}
+          cx={r.at.x} cy={r.at.y} r={dot} strokeWidth={dot / 2.5}>
+          <title>{(r.label ?? r.node_id) + ' · ' + (reported ? r.position_source : t('fms.twin.declaredPlace'))}</title>
+        </circle>;
+      })}
+    </g>)}
+  </svg>;
+}
+
+/**
+ * 도면에 점이 없는 로봇이 몇인지. **표에는 둘인데 점이 하나면 설명이 필요하다** —
+ * 설명이 없으면 보는 사람은 없는 점을 「사라진 로봇」으로 읽는다. 「자리를 모른다」와
+ * 「로봇이 없다」는 다른 사실이다.
+ */
+function withoutPlace(zones: readonly Zone[]): { missing: number; total: number } {
+  const robots = zones.flatMap((z) => z.robots ?? []);
+  const missing = robots.filter((r) => r.at?.x === undefined || r.at?.y === undefined).length;
+  return { missing, total: robots.length };
+}
