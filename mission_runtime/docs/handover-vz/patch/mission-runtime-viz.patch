@@ -0,0 +1,86 @@
+/* src/fms/fms.css (261105 — FMS 노드 다섯)
+ *
+ * 표현은 **이 파일에만** 있다. 서버 응답에는 색·픽셀·폰트가 없다
+ * (AI 쪽 `docs/view-contract.md` §3 — 데이터와 렌더러가 갈려 있다).
+ *
+ * 색판은 이 앱의 밝은 테마를 따른다 — `src/sar/sar.css` 의 배지와 **같은 값**이다.
+ * 자기 색을 따로 쓰면 같은 화면 안에서 초록이 두 가지가 된다.
+ */
+
+.fms-card { display: flex; flex-direction: column; gap: 4px; font-size: 12px; }
+.fms-card__line { display: flex; gap: 6px; align-items: baseline; flex-wrap: wrap; }
+.fms-card__line b { font-weight: 600; color: #3d4756; }
+.fms-num { font-variant-numeric: tabular-nums; font-weight: 600; }
+
+/* 세 상태를 색만이 아니라 **글자로도** 가른다 — 색을 못 가리는 사람에게 구분이
+ * 사라지면 안 된다. 미측정은 0 도 미달도 아니라서 **테두리까지 다르다**(점선). */
+.fms-state { display: inline-block; margin-left: 5px; padding: 0 5px; border: 1px solid;
+             border-radius: 3px; font-size: 11px; white-space: nowrap; }
+/* 칸의 맨 앞에 혼자 서는 조각은 붙여 둔다 — 글자 뒤에 붙을 때만 띄운다. */
+.fms-table td > .fms-state:first-child, .fms-card__line > .fms-state:first-child { margin-left: 0; }
+.fms-state--ok { color: #125c33; background: #d8f0e2; border-color: #1f8a4d; }
+.fms-state--warn { color: #7a4a07; background: #fdf1d8; border-color: #d39b2a; }
+.fms-state--bad { color: #a33a3a; background: #fbe3e3; border-color: #e15a5a; }
+.fms-state--unmeasured { color: #6b7888; background: #fff; border-color: #cbd3dc; border-style: dashed; font-style: italic; }
+
+.fms-empty { color: #6b7888; font-size: 12px; margin: 0; }
+.fms-error { color: #a33a3a; font-size: 12px; margin: 0; word-break: break-all; }
+.fms-hint { color: #8a94a2; font-size: 11px; margin: 2px 0 0; }
+
+.fms-zoom { display: flex; flex-direction: column; gap: 10px; font-size: 13px; }
+/* 확대 본문. 겉 `.fms-zoom` 안에 들어가므로 묶음을 또 만들지 않는다 — 두 겹이면
+ * 사이 여백이 두 번 들어간다. */
+.fms-zoom__body { display: contents; }
+.fms-zoom__head { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
+.fms-zoom__head h3 { margin: 0; font-size: 14px; }
+.fms-zoom section { border: 1px solid #dfe3e8; border-radius: 4px; padding: 8px; background: #fff; }
+.fms-zoom section > h4 { margin: 0 0 6px; font-size: 12px; color: #3d4756; }
+
+.fms-table { width: 100%; border-collapse: collapse; font-size: 12px; }
+.fms-table th, .fms-table td { text-align: left; padding: 3px 6px; border-bottom: 1px solid #eef1f4; vertical-align: top; }
+.fms-table th { color: #6b7888; font-weight: 500; }
+.fms-table tbody tr.is-blocked td { background: #fdf4f4; }
+
+.fms-chips { display: flex; gap: 4px; flex-wrap: wrap; margin: 0; padding: 0; list-style: none; }
+.fms-chips li { background: #f2f4f6; border: 1px solid #dfe3e8; border-radius: 3px; padding: 1px 5px; font-size: 11px; }
+.fms-chips li.is-missing { background: #fbe3e3; border-color: #e15a5a; color: #a33a3a; }
+
+/* 한 칸 안에 여럿이 들어갈 때 쓰는 낱개 조각(가속기에 배치된 서비스 이름 등). */
+.fms-chip { display: inline-block; background: #f2f4f6; border: 1px solid #dfe3e8; border-radius: 3px;
+            padding: 0 5px; margin: 0 3px 2px 0; font-size: 11px; }
+/* 서비스 줄 안의 지표 표. 바깥 표의 줄과 섞이지 않게 테두리를 지운다. */
+.fms-table--inner { font-size: 11px; }
+.fms-table--inner th, .fms-table--inner td { border-bottom: none; padding: 1px 6px 1px 0; }
+.fms-table--inner th { font-weight: 400; color: #55606e; }
+
+.fms-actions { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
+.fms-actions select, .fms-actions button, .fms-actions input { font: inherit; font-size: 12px; }
+
+/* 맵은 **데이터와 렌더러가 분리**되어 있다. 지금은 사각형 도면이고, 3D 뷰어가 생기면
+ * 이 블록만 바뀐다 — 서버 응답은 그대로다. */
+/* **높이를 묶는다.** 묶지 않으면 세로로 긴 도면이 화면을 통째로 밀어낸다 —
+ * 52 m × 46 m 구역 하나가 1,300 px 짜리 벽이 됐다. */
+.fms-map { width: 100%; max-height: 360px; background: #f7f9fb; border: 1px solid #dfe3e8; border-radius: 4px; }
+.fms-map__zone { fill: #e7f0fb; stroke: #4a8fd4; }
+/* 점선 간격은 도면 크기에 비례해 인라인으로 준다 — 고정값은 50 m 도면에서 사라진다. */
+.fms-map__zone--unverified { opacity: .85; }
+.fms-map__robot { fill: #1f8a4d; stroke: none; }
+/* **선언된 자리**는 속이 빈 점선이다. 채워 그리면 「장치가 거기 있다고 보고했다」로
+ * 읽힌다 — 선언과 관측은 다른 사실이다(AI-C-02). */
+.fms-map__robot--declared { fill: none; stroke: #1f8a4d; stroke-dasharray: 2 1.5; }
+.fms-map__robot--absent { fill: #aab4c0; stroke: #aab4c0; }
+.fms-map__robot--declared.fms-map__robot--absent { fill: none; }
+.fms-map__label { fill: #3d4756; }
+
+/* 실행 단위 한 줄(261120 — FmsStack). 단추가 **줄 안에** 있다: 목록과 조작을 다른
+ * 칸에 두면 어느 줄을 켜는지 눈이 한 번 더 찾아야 하고, 그 찾기가 틀리면 다른
+ * 단위를 켠다. 색만으로 상태를 말하지 않는 규칙은 위 `.fms-state` 와 같다. */
+.fms-row { border: 1px solid #dfe3e8; border-radius: 4px; padding: 8px; background: #fff;
+           display: flex; flex-direction: column; gap: 4px; }
+.fms-row__head { display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
+.fms-row__state { display: flex; gap: 6px; align-items: baseline; flex-wrap: wrap; }
+.fms-row__acts { display: flex; gap: 6px; margin-top: 2px; }
+/* 멈춘 이유는 **한 줄**로만 보인다 — 로그를 여는 창구를 만들지 않는다(파일을 여는
+ * 길을 열면 그 길로 다른 파일도 열린다). 길면 자른다. */
+.fms-row__log { font-family: ui-monospace, monospace; white-space: nowrap; overflow: hidden;
+                text-overflow: ellipsis; }
diff --git a/viz-debugger/src/fms/fmsApi.ts b/viz-debugger/src/fms/fmsApi.ts
new file mode 100644
index 0000000..fece6c5
--- /dev/null
+++ b/viz-debugger/src/fms/fmsApi.ts
@@ -0,0 +1,297 @@
+/**
+ * src/fms/fmsApi.ts (261105 신설 — FMS 관제 화면을 이 앱 안으로)
+ *
+ * **AI 파트의 조회 계약을 읽는다.** 디지털 트윈 맵 · 추천 임무 · 서브태스크 접지 ·
+ * 계층별 지표 · 장치 관리는 전에 AI 쪽 **별도 웹**(FMS 콘솔)에 있었다. 그 웹이
+ * 2026-11-05 에 지워지고 같은 계약이 **게이트웨이**로 왔다 — 즉 이 앱이 이미 보는
+ * 주소다(`/registry` 와 같은 포트).
+ *
+ * ## 새 주소를 만들지 않는다
+ *
+ * `GATEWAY.http` 를 그대로 쓴다. 연결 관리에 창구를 하나 더 만들면 같은 서버의
+ * 주소가 화면에 둘이 되고, 하나만 고친 날 「/registry 는 되는데 FMS 는 안 된다」가
+ * 된다. 게이트웨이는 하나다(`verify:one-gateway` 와 같은 이유).
+ *
+ * ## 폴링하지 않는다
+ *
+ * 노드를 놓거나 열 때 한 번 읽고, 그 뒤는 **사람이 다시 읽기를 누를 때**만 읽는다.
+ * 저쪽 계약의 규칙이기도 하다 — 아무도 보지 않는 구역을 상시 갱신하면 그 구역의
+ * 추론·전송까지 계속 돈다(AI-C-13 · AI-O-01). 카드를 넷 놓았다고 폴링이 넷 돌지
+ * 않는다.
+ *
+ * ## 세션은 쿠키가 아니라 Bearer 다
+ *
+ * 우리는 저쪽과 **다른 출처**다. 교차 출처 쿠키를 허용하려면 자격증명을 열어야 하고,
+ * 그 순간 운영자가 방문한 아무 사이트가 그 브라우저로 명령을 보낼 수 있다(CSRF).
+ * 그래서 토큰은 `/api/login`·`/api/assume` 응답 **본문**에서 받아 머리에 붙인다.
+ *
+ * 토큰이 없어도 조회 21개는 열려 있다. 권한이 걸린 일곱(`/api/object` 추론 근거 ·
+ * `/api/failure` · `/api/overlay` · `/api/lineage` · `/api/accounts` ·
+ * `/api/label/tasks` · `/api/label/task`)만 403 이고, 그 사유에 **어느 능력이
+ * 필요한지**가 적혀 온다.
+ */
+
+import { GATEWAY } from '../transport/index.ts';
+import { t } from '../i18n/dict.ts';
+
+/** 저쪽이 공표하는 계약 판. 응답 머리에서 읽는다 — 문서에만 있으면 맞출 길이 없다. */
+let contractVersion: string | null = null;
+
+export function fmsContractVersion(): string | null {
+  return contractVersion;
+}
+
+const TOKEN_KEY = 'fms.session';
+
+/** 세션 토큰. 새로고침에도 남는다 — 매번 다시 들어오게 하지 않는다. */
+function storedToken(): string | null {
+  try {
+    const raw = globalThis.localStorage?.getItem(TOKEN_KEY);
+    return raw === null || raw === '' ? null : raw;
+  } catch {
+    return null;                 // 사생활 보호 모드 등 — 없는 것으로 본다
+  }
+}
+
+function storeToken(token: string | null): void {
+  try {
+    if (token === null) globalThis.localStorage?.removeItem(TOKEN_KEY);
+    else globalThis.localStorage?.setItem(TOKEN_KEY, token);
+  } catch {
+    /* 저장하지 못해도 이번 세션은 돈다 */
+  }
+}
+
+let token: string | null = storedToken();
+
+export function fmsToken(): string | null {
+  return token;
+}
+
+/** 조회의 결과. **사유를 버리지 않는다** — 빈 화면은 「없다」와 「못 읽었다」를 섞는다. */
+export type FmsRead<T> =
+  | { ok: true; body: T }
+  | { ok: false; status: number; error: string; needs: string | null };
+
+/** `missing_permission:<능력>` 에서 능력 이름만 꺼낸다. 아니면 null. */
+function neededCapability(error: string): string | null {
+  const marker = 'missing_permission:';
+  return error.startsWith(marker) ? error.slice(marker.length) : null;
+}
+
+function base(): string {
+  return GATEWAY.http.trim().replace(/\/+$/, '');
+}
+
+/**
+ * 조회 한 건. 경로는 `/api/...` 그대로 주고, 질의는 호출자가 만든다.
+ *
+ * **조용히 성공하지 않는다** — 4xx·5xx 는 본문의 통제 어휘 토큰을 그대로 들고 온다
+ * (`schemas/view_error.schema.json` — `{"error": "<토큰>"}` 하나다).
+ */
+export async function readFms<T>(path: string, signal?: AbortSignal): Promise<FmsRead<T>> {
+  const address = base();
+  if (address === '') return { ok: false, status: 0, error: t('fms.noAddress'), needs: null };
+  const headers: Record<string, string> = {};
+  if (token !== null) headers.Authorization = `Bearer ${token}`;
+  let response: Response;
+  try {
+    response = await fetch(address + path, { headers, signal });
+  } catch (error) {
+    // CORS · 주소 오류 · 꺼진 서버가 모두 여기로 온다. 사유를 그대로 보인다.
+    return {
+      ok: false, status: 0, needs: null,
+      error: error instanceof Error ? error.message : String(error),
+    };
+  }
+  const announced = response.headers.get('Server');
+  if (announced !== null && /^FMS\//.test(announced)) contractVersion = announced;
+  let body: unknown = null;
+  try {
+    body = await response.json();
+  } catch {
+    body = null;
+  }
+  if (!response.ok) {
+    const reason = typeof (body as { error?: unknown } | null)?.error === 'string'
+      ? (body as { error: string }).error
+      : t('fms.status', { status: response.status });
+    return { ok: false, status: response.status, error: reason, needs: neededCapability(reason) };
+  }
+  return { ok: true, body: body as T };
+}
+
+export type FmsIdentity = {
+  actor: string;
+  authenticated: boolean;
+  permissions: readonly string[];
+  selectable_accounts: readonly { account_id: string; display_name: string; role: string }[];
+  unconfigured?: boolean;
+  session_token?: string;
+  error?: string;
+};
+
+/** 쓰기 한 건. 이 파일에서 쓰는 것은 **들어오고 나가는 것**뿐이다(§AI-C-19). */
+async function write(path: string, payload: unknown): Promise<FmsRead<FmsIdentity>> {
+  const address = base();
+  if (address === '') return { ok: false, status: 0, error: t('fms.noAddress'), needs: null };
+  const headers: Record<string, string> = { 'Content-Type': 'application/json' };
+  if (token !== null) headers.Authorization = `Bearer ${token}`;
+  let response: Response;
+  try {
+    response = await fetch(address + path, { method: 'POST', headers, body: JSON.stringify(payload) });
+  } catch (error) {
+    return {
+      ok: false, status: 0, needs: null,
+      error: error instanceof Error ? error.message : String(error),
+    };
+  }
+  let body: unknown = null;
+  try {
+    body = await response.json();
+  } catch {
+    body = null;
+  }
+  if (!response.ok) {
+    const reason = typeof (body as { error?: unknown } | null)?.error === 'string'
+      ? (body as { error: string }).error
+      : t('fms.status', { status: response.status });
+    return { ok: false, status: response.status, error: reason, needs: neededCapability(reason) };
+  }
+  const identity = body as FmsIdentity;
+  if (typeof identity.session_token === 'string' && identity.session_token !== '') {
+    token = identity.session_token;
+    storeToken(token);
+  }
+  return { ok: true, body: identity };
+}
+
+/**
+ * 선언된 실행 단위 하나(`GET /api/services` 의 한 줄).
+ *
+ * **`ready` 는 세 값이다** — true · false · null(묻지 않았다). `status` 와 다른
+ * 축인 것이 요점이다: 떠 있는데(RUNNING) 준비되지 않은 상태가 정상으로 존재한다.
+ * `exit_code: null` 은 「돌고 있다」 또는 「띄운 적 없다」이고 0 이 아니다 — 0 은
+ * 「정상으로 끝났다」다.
+ */
+export type FmsUnit = {
+  unit_id: string;
+  kind: string;
+  label?: Record<string, string>;
+  status: string;
+  ready: boolean | null;
+  ready_port: number | null;
+  depends_on: readonly string[];
+  log_path: string | null;
+  exit_code: number | null;
+  last_output: string | null;
+  note?: string;
+};
+
+export type FmsServices = {
+  units: readonly FmsUnit[];
+  /** 거짓이면 이 설치는 **띄우지 않는다**(선언 파일이 없다). 빈 목록과 다른 사실이다. */
+  configured: boolean;
+  reason: string | null;
+};
+
+export type FmsStackOutcome = {
+  unit_id: string;
+  action: string;
+  accepted: boolean;
+  status: string | null;
+  /** 거절 사유 토큰. `dependency_not_running:<단위>` 처럼 **무엇이** 막았는지 적힌다. */
+  reason: string | null;
+  actor: string;
+};
+
+/**
+ * 단위 하나를 세우거나 내린다(`POST /api/stack`).
+ *
+ * **단위 이름만 보낸다.** 저쪽은 명령줄을 받지 않는다 — 받으면 쓰기 계약 하나가
+ * 원격 코드 실행 창구가 된다. 무엇을 띄울 수 있는지는 저쪽 기계의 선언이 정하고,
+ * 우리는 그 목록에서 고르기만 한다.
+ */
+export async function fmsStack(
+  unitId: string, action: 'start' | 'stop' | 'restart',
+): Promise<FmsRead<FmsStackOutcome>> {
+  return writeJson<FmsStackOutcome>('/api/stack', { unit_id: unitId, action });
+}
+
+/**
+ * 세션이 아닌 쓰기. `write()` 와 나눠 둔 이유: 그쪽은 **토큰을 받아 저장하는**
+ * 경로이고(로그인·자세), 이쪽은 토큰을 **쓰는** 경로다. 한 함수로 합치면 아무
+ * 응답에서나 토큰을 주워 저장하게 된다.
+ */
+async function writeJson<T>(path: string, payload: unknown): Promise<FmsRead<T>> {
+  const address = base();
+  if (address === '') return { ok: false, status: 0, error: t('fms.noAddress'), needs: null };
+  const headers: Record<string, string> = { 'Content-Type': 'application/json' };
+  if (token !== null) headers.Authorization = `Bearer ${token}`;
+  let response: Response;
+  try {
+    response = await fetch(address + path, { method: 'POST', headers, body: JSON.stringify(payload) });
+  } catch (error) {
+    return {
+      ok: false, status: 0, needs: null,
+      error: error instanceof Error ? error.message : String(error),
+    };
+  }
+  let body: unknown = null;
+  try {
+    body = await response.json();
+  } catch {
+    body = null;
+  }
+  if (!response.ok) {
+    const reason = typeof (body as { error?: unknown } | null)?.error === 'string'
+      ? (body as { error: string }).error
+      : t('fms.status', { status: response.status });
+    return { ok: false, status: response.status, error: reason, needs: neededCapability(reason) };
+  }
+  return { ok: true, body: body as T };
+}
+
+/** 누구로 와 있는지. 권한이 필요 없다 — 답이 「아무도 아니다」일 수 있어야 한다. */
+export function fmsIdentity(signal?: AbortSignal): Promise<FmsRead<FmsIdentity>> {
+  return readFms<FmsIdentity>('/api/identity', signal);
+}
+
+/** 예시 계정을 골라 들어온다. 계정 파일이 있는 설치에서는 저쪽이 403 으로 거절한다. */
+export function fmsAssume(accountId: string): Promise<FmsRead<FmsIdentity>> {
+  return write('/api/assume', { account: accountId });
+}
+
+/** 계정으로 들어온다. */
+export function fmsLogin(accountId: string, password: string): Promise<FmsRead<FmsIdentity>> {
+  return write('/api/login', { account_id: accountId, password });
+}
+
+/** 나간다. 토큰을 버리는 것은 응답과 무관하게 **여기서** 한다. */
+export async function fmsLogout(): Promise<void> {
+  await write('/api/logout', {});
+  token = null;
+  storeToken(null);
+}
+
+/**
+ * **`label` 은 두 모양이다** — 계약이 그렇게 적는다(view-contract §8).
+ *
+ *   도메인 · 구역 · 층 · 현장   `{"ko": "...", "en": "..."}`  배치 데이터의 언어별 이름
+ *   로봇                        평평한 문자열                  번역이 없다
+ *
+ * 묶음 쪽을 그대로 그리면 React 가 「객체는 자식이 될 수 없다」로 터진다. 실제로
+ * 그렇게 터뜨렸다. 고른 locale 을 먼저 찾고 없으면 **아무 하나**를 쓴다 — 빈칸을
+ * 그리지 않는 것이 계약이 요구하는 쪽이다.
+ */
+export function localized(value: unknown, lang: string): string | null {
+  if (typeof value === 'string') return value === '' ? null : value;
+  if (value === null || typeof value !== 'object') return null;
+  const table = value as Record<string, unknown>;
+  const picked = table[lang];
+  if (typeof picked === 'string' && picked !== '') return picked;
+  for (const candidate of Object.values(table)) {
+    if (typeof candidate === 'string' && candidate !== '') return candidate;
+  }
+  return null;
+}
