+++ b/web-dashboard/src/views/EvidenceDetail.tsx
@@ -0,0 +1,179 @@
+/**
+ * 근거 확인 노드 — 그래프의 근거 노드를 누르면 **한 칸 더** 펴지는 노드.
+ *
+ * 왜 노드인가: 근거는 임무 그래프 바깥의 곁다리가 아니라 그 서브태스크가 왜 그렇게
+ * 판단됐는지의 일부다. 모달로 띄우면 그래프에서 떨어져 나가고, 한 줄 텍스트로 두면
+ * (지금처럼) "무엇을 보고 묶었는가" 에 답하지 못한다.
+ *
+ * 여기서 지키는 것 넷 (AI-S-02 · AI-S-03):
+ *   1. 질의 관측과 후보를 **나란히** 둔다 — 사람은 수보다 그림을 먼저 본다.
+ *   2. 단서별 기여를 **부호 있는 막대**로 — 길이가 크기, 색이 방향.
+ *   3. 가리는 근거 / 가리지 못하는 근거를 **갈라 둔다** — 외형은 종류만 말한다.
+ *   4. 미측정은 0 이 아니라 **빈 칸**이다.
+ *
+ * 숫자는 **AI 계약이 채울 자리**이고 지금 게이트웨이는 이 채널을 발행하지 않는다.
+ * 그 사실을 패널이 직접 적는다 — 없는 근거를 만들지 않기 위해서다.
+ */
+
+export type Cue = {
+  cue: string;
+  raw: number | null;
+  contribution: number | null;
+  verdict: '일치' | '불일치' | '미측정';
+  discriminating: boolean;
+};
+
+export type EvidenceCase = {
+  queryId: string;
+  decision: '수락' | '미결정';
+  margin: number;
+  threshold: number;
+  candidates: Array<{ img: string; score: number; rank: number; picked: boolean }>;
+  cues: Cue[];
+  remedy: string | null;
+};
+
+/** 같은 노드는 늘 같은 예시를 보도록 — 누를 때마다 숫자가 바뀌면 설명이 안 된다. */
+function seeded(entity: string): number {
+  let h = 0;
+  for (const ch of entity) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
+  return h;
+}
+
+export function sampleCase(entity: string, taskIndex: number): EvidenceCase {
+  const undecided = seeded(entity + taskIndex) % 3 === 0;
+  if (undecided) {
+    return {
+      queryId: `obs-${4400 + (seeded(entity) % 90)}`,
+      decision: '미결정',
+      margin: 0.06,
+      threshold: 0.85,
+      candidates: [
+        { img: 'cand1.jpg', score: 0.52, rank: 1, picked: false },
+        { img: 'cand2.jpg', score: 0.46, rank: 2, picked: false },
+      ],
+      cues: [
+        { cue: 'radio_range', raw: null, contribution: null, verdict: '미측정', discriminating: true },
+        { cue: 'motion_correlation', raw: null, contribution: null, verdict: '미측정', discriminating: true },
+        { cue: 'appearance', raw: 0.93, contribution: 0.15, verdict: '일치', discriminating: false },
+        { cue: 'declared_type', raw: 0.88, contribution: 0.04, verdict: '일치', discriminating: false },
+      ],
+      remedy: '운동 프로브 — 두 후보에 서로 다른 짧은 이동을 지시하면 motion_correlation 이 측정되어 갈린다. 하드웨어 변경이 없다.',
+    };
+  }
+  return {
+    queryId: `obs-${4400 + (seeded(entity) % 90)}`,
+    decision: '수락',
+    margin: 1.42,
+    threshold: 0.85,
+    candidates: [
+      { img: 'cand1.jpg', score: 2.37, rank: 1, picked: true },
+      { img: 'cand2.jpg', score: 0.95, rank: 2, picked: false },
+      { img: 'cand3.jpg', score: -0.41, rank: 3, picked: false },
+    ],
+    cues: [
+      { cue: 'radio_range', raw: 0.78, contribution: 1.31, verdict: '일치', discriminating: true },
+      { cue: 'motion_correlation', raw: 0.64, contribution: 0.88, verdict: '일치', discriminating: true },
+      { cue: 'fiducial_marker', raw: null, contribution: null, verdict: '미측정', discriminating: true },
+      { cue: 'appearance', raw: 0.91, contribution: 0.14, verdict: '일치', discriminating: false },
+      { cue: 'declared_type', raw: 0.88, contribution: 0.04, verdict: '일치', discriminating: false },
+    ],
+    remedy: null,
+  };
+}
+
+const BAR_MAX = 92;          // 가장 큰 기여가 이 길이가 된다
+function barWidth(value: number, peak: number): number {
+  return Math.max(3, Math.round((Math.abs(value) / peak) * BAR_MAX));
+}
+
+function CueRows({ cues, peak }: { cues: Cue[]; peak: number }) {
+  return <>{cues.map((c) => (
+    <tr key={c.cue} className={c.verdict === '미측정' ? 'cuerow cuerow--none' : 'cuerow'}>
+      <td className="cuerow__name">{c.cue}</td>
+      <td className="cuerow__raw">{c.raw === null ? '—' : c.raw.toFixed(2)}</td>
+      <td className={'cuerow__contrib' + (c.contribution === null ? '' : c.contribution >= 0 ? ' is-match' : ' is-differ')}>
+        {c.contribution === null ? '—' : (c.contribution >= 0 ? '+' : '') + c.contribution.toFixed(2)}
+      </td>
+      <td className="cuerow__bar">
+        <span
+          className={'cuebar ' + (c.contribution === null ? 'cuebar--none' : c.contribution >= 0 ? 'cuebar--match' : 'cuebar--differ')}
+          style={{ width: (c.contribution === null ? 30 : barWidth(c.contribution, peak)) + 'px' }}
+        />
+      </td>
+      <td className="cuerow__verdict">{c.verdict}</td>
+    </tr>
+  ))}</>;
+}
+
+export function EvidenceDetailNode({
+  detail, label, taskIndex, left, top, onClose,
+}: {
+  detail: EvidenceCase; label: string; taskIndex: number;
+  left: number; top: number; onClose: () => void;
+}) {
+  const discriminating = detail.cues.filter((c) => c.discriminating);
+  const weak = detail.cues.filter((c) => !c.discriminating);
+  const peak = Math.max(...detail.cues.map((c) => Math.abs(c.contribution ?? 0)), 0.1);
+
+  return (
+    <article className="evdetail" style={{ left, top }}>
+      <header className="evdetail__head">
+        <b>근거 확인 — {label}</b>
+        <span className={'evdetail__pill evdetail__pill--' + (detail.decision === '수락' ? 'ok' : 'hold')}>
+          {detail.decision === '수락' ? '수락 · 1위 채택' : '미결정 · 고르지 않음'}
+        </span>
+        <span className="evdetail__meta">
+          질의 {detail.queryId} · Sub task {taskIndex} · 2위와 격차 <b>{detail.margin.toFixed(2)}</b>
+          {detail.decision === '미결정' ? ' — 문턱 미만' : ` · 문턱 ${detail.threshold.toFixed(2)}`}
+        </span>
+        <button type="button" className="evdetail__close" onClick={onClose} aria-label="근거 확인 닫기">✕</button>
+      </header>
+
+      <div className="evdetail__strip">
+        <figure className="evslot evslot--query">
+          <img src="/evidence/query.jpg" alt="질의 관측" />
+          <figcaption>질의 관측</figcaption>
+        </figure>
+        {detail.candidates.map((c) => (
+          <figure key={c.rank} className={'evslot' + (c.picked ? ' evslot--picked' : '')}>
+            <img src={'/evidence/' + c.img} alt={`후보 ${c.rank}`} />
+            <figcaption>
+              <b>{(c.score >= 0 ? '+' : '') + c.score.toFixed(2)}</b>
+              {c.rank}위{c.picked ? ' · 채택' : ''}
+            </figcaption>
+          </figure>
+        ))}
+      </div>
+
+      <table className="evtable">
+        <thead><tr><th>단서</th><th>원점수</th><th>기여</th><th /><th>판정</th></tr></thead>
+        <tbody>
+          <tr className="cuegroup"><td colSpan={5}>가리는 근거 — 개체를 특정한다</td></tr>
+          <CueRows cues={discriminating} peak={peak} />
+          <tr className="cuegroup"><td colSpan={5}>가리지 못하는 근거 — 종류만 말한다</td></tr>
+          <CueRows cues={weak} peak={peak} />
+        </tbody>
+      </table>
+
+      <p className="evdetail__note">
+        <b>막대 길이가 곧 기여다.</b> 가리지 못하는 근거는 원점수가 높아도 기여가 짧다 —
+        같은 기종 둘은 외형이 거의 같아 <b>개체를 가르지 못한다</b>. 아무리 쌓여도 위 묶음을
+        뒤집지 않는다. 미측정은 <b>0 이 아니라 빈 칸</b>이다.
+      </p>
+
+      {detail.remedy !== null && (
+        <p className="evdetail__remedy">
+          <b>해법 요청</b> — {detail.remedy}
+          <span> ※ 실제 명령 발급은 백엔드·하드웨어 경계를 거친다(AI-C-19).</span>
+        </p>
+      )}
+
+      <p className="evdetail__src">
+        AI 계약이 채울 자리 — <code>evidence_kinds</code> · <code>detection-result</code>.
+        <b> 지금 게이트웨이는 이 채널을 발행하지 않는다</b>: 위 수치는 모양을 보이기 위한
+        예시이고 관측값이 아니다.
+      </p>
+    </article>
+  );
+}
